---
import ShapeDiagram from './ShapeDiagram.astro';
import ResultsPanel from './ResultsPanel.astro';
import Equivalents from './Equivalents.astro';
import FormulaSteps from './FormulaSteps.astro';
---

<div id="calculator" class="w-full scroll-mt-20">
  <!-- Active Shape Card & Calculator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <!-- Left Column: Inputs & Shape Information (7 cols on lg) -->
    <div class="lg:col-span-7 flex flex-col gap-6">
      <div class="bg-white rounded-xl border border-hairline p-5 sm:p-6 shadow-xs">
        <!-- Shape Header Info -->
        <div class="flex items-start justify-between gap-3 mb-4 pb-3 border-b border-hairline">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span id="active-shape-badge" class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full border bg-primary/10 text-primary border-primary/20">
                Basic 3D
              </span>
              <span class="text-xs text-ink-faint">•</span>
              <span class="text-xs text-ink-muted">Reactive Math</span>
            </div>
            <h2 id="active-shape-title" class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
              Cube
            </h2>
          </div>

          <!-- Right Header Controls -->
          <div class="flex items-center gap-2">
            <a
              id="active-shape-dedicated-link"
              href="/cube-volume-calculator"
              class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-full text-[11px] sm:text-xs font-semibold bg-primary/10 border border-primary/20 text-primary hover:bg-primary hover:text-white transition-all shadow-2xs"
              title="Open standalone page for this shape"
            >
              <span class="hidden xs:inline">Dedicated Single Page</span>
              <span class="xs:hidden">Single Page</span>
              <span>→</span>
            </a>

            <!-- Quick Reset Button -->
            <button
              type="button"
              id="reset-inputs-btn"
              class="text-xs font-medium px-2.5 py-1.5 rounded-md bg-canvas-soft border border-hairline text-ink-muted hover:text-ink hover:border-ink-muted transition-colors cursor-pointer"
              title="Reset to default dimensions"
            >
              Reset
            </button>
          </div>
        </div>

        <p id="active-shape-summary" class="text-xs sm:text-sm text-ink-secondary mb-5 leading-relaxed">
          A 3D solid bounded by six equal square faces with equal edges.
        </p>

        <!-- Preset Chips -->
        <div class="mb-5">
          <div class="text-[11px] font-semibold uppercase tracking-wider text-ink-muted mb-2 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
            <span>Quick Presets:</span>
          </div>
          <div id="presets-chips-container" class="flex flex-wrap gap-1.5">
            <!-- Populated dynamically -->
          </div>
        </div>

        <!-- Two Column Inputs + Visual Diagram -->
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-5 items-center">
          <!-- Dynamic Input Fields (7 cols on sm) -->
          <div id="dynamic-inputs-container" class="sm:col-span-7 flex flex-col gap-3.5">
            <!-- Form inputs injected by calculator.ts -->
          </div>

          <!-- Isometric Diagram Guide (5 cols on sm) -->
          <div class="sm:col-span-5">
            <ShapeDiagram />
          </div>
        </div>
      </div>

      <!-- Step-by-Step Formula Derivation -->
      <FormulaSteps />
    </div>

    <!-- Right Column: Results Panel & Equivalents (5 cols on lg) -->
    <div class="lg:col-span-5 flex flex-col gap-6 sticky top-20">
      <!-- Main Results Panel -->
      <ResultsPanel />

      <!-- Real-World Equivalents -->
      <Equivalents />
    </div>
  </div>

  <!-- Mobile Sticky Bottom Floating Result Bar -->
  <div
    id="mobile-sticky-bar"
    class="lg:hidden fixed bottom-0 left-0 right-0 z-30 bg-white/95 backdrop-blur-md border-t border-hairline px-4 py-2.5 shadow-lg flex items-center justify-between"
  >
    <div>
      <span class="text-[10px] text-ink-muted uppercase block font-semibold">Total Volume</span>
      <div class="flex items-baseline gap-1.5">
        <span id="mobile-volume-val" class="font-bold text-lg font-mono text-ink">0.0000</span>
        <span id="mobile-volume-unit" class="text-xs font-semibold text-primary">m³</span>
      </div>
    </div>
    <a
      href="#results-panel"
      class="px-3.5 py-1.5 text-xs font-semibold rounded-full bg-primary text-white active:scale-95 transition-transform"
    >
      View Details & Units
    </a>
  </div>
</div>
