---
// FeaturedToolsSection.astro - High-intent featured calculators & geometric formulas section
import { ICONS } from '../scripts/icons';

const FEATURED_TOOLS = [
  {
    name: 'Cylinder Volume',
    href: '/cylinder-volume-calculator',
    formula: 'V = π · r² · h',
    tag: 'Tanks, pipes & cylinders',
    description: 'Calculate volume and liquid capacity for cylindrical storage tanks, pipes, circular columns, and cans in gallons, litres, and cubic meters.',
    icon: ICONS.cylinder,
  },
  {
    name: 'Pool Volume Calculator',
    href: '/pool-volume-calculator',
    formula: 'V = L · W · D · 7.48',
    tag: 'Gallons & water capacity',
    description: 'Calculate water volume and chemical requirements for rectangular, circular, and oval swimming pools with shallow and deep ends.',
    icon: ICONS.pool,
  },
  {
    name: 'Cubic Volume',
    href: '/cubic-feet-calculator',
    formula: 'V = L · W · H (cu ft)',
    tag: 'Cu ft & cubic yards',
    description: 'Determine cubic volume in cubic feet and cubic yards from inches, feet, or meters for mulch, soil, gravel, and concrete projects.',
    icon: ICONS.cube,
  },
  {
    name: 'Sphere Formula',
    href: '/sphere-volume-calculator',
    formula: 'V = (4/3) · π · r³',
    tag: 'Spherical vessels & domes',
    description: 'Apply the classical sphere formula to calculate volume, radius, and fluid displacement for globes, tanks, and round storage containers.',
    icon: ICONS.sphere,
  },
  {
    name: 'Pyramid Volume Formula',
    href: '/square-pyramid-volume-calculator',
    formula: 'V = (1/3) · a² · h',
    tag: 'Square & architectural pyramids',
    description: 'Calculate three-dimensional capacity and apex height for square pyramids, hip roofs, and monumental architecture.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M12 2L2 19h20L12 2z"></path><path d="M12 2v17"></path></svg>`,
  },
];
---

<section class="w-full max-w-7xl mx-auto space-y-6 pt-2">
  <div class="text-center max-w-2xl mx-auto space-y-2">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 border border-primary/20 text-primary">
      <span>Featured calculators and formulas</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight">
      Popular volume calculators and formulas
    </h2>
    <p class="text-sm sm:text-base text-ink-secondary">
      Direct access to our most requested geometric calculation and water capacity tools with step-by-step arithmetic.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
    {FEATURED_TOOLS.map((tool) => (
      <a
        href={tool.href}
        class="group p-5 sm:p-6 rounded-2xl bg-white dark:bg-canvas-card border border-hairline hover:border-primary/50 shadow-xs hover:shadow-md transition-all flex flex-col justify-between"
      >
        <div class="space-y-3">
          <div class="flex items-center justify-between gap-3">
            <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <Fragment set:html={tool.icon} />
            </div>
            <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-canvas-soft border border-hairline text-ink-muted">
              {tool.tag}
            </span>
          </div>

          <div>
            <h3 class="font-bold text-base sm:text-lg text-ink group-hover:text-primary transition-colors flex items-center gap-1.5">
              <span>{tool.name}</span>
            </h3>
            <p class="text-xs sm:text-sm text-ink-secondary mt-1.5 leading-relaxed">
              {tool.description}
            </p>
          </div>
        </div>

        <div class="mt-5 pt-3 border-t border-hairline flex items-center justify-between text-xs">
          <span class="font-mono text-[11px] text-ink-muted bg-canvas-soft px-2 py-1 rounded">
            {tool.formula}
          </span>
          <span class="font-semibold text-primary group-hover:translate-x-0.5 transition-transform flex items-center gap-1">
            <span>Calculate</span>
            <span>→</span>
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
