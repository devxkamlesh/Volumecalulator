    <!-- Bottom Copyright & Author -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-ink-muted">
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
        <p>© {new Date().getFullYear()} thevolumecalculator.com.</p>
        <span class="hidden sm:inline text-hairline">|</span>
        <p>
          {isPortuguese ? 'Desenvolvido por' : isFrench ? 'Développé par' : isSpanish ? 'Desarrollado por' : isGerman ? 'Entwickelt von' : 'Engineered by'} <a href="https://x.com/devxkamlesh" target="_blank" rel="noopener noreferrer" class="font-semibold text-primary hover:underline">Kamlesh Choudhary</a> <span class="text-ink-faint">(<a href="https://x.com/devxkamlesh" target="_blank" rel="noopener noreferrer" class="hover:underline">@devxkamlesh</a>)</span>
