        </h3>
        {isPortuguese ? (
          <ul class="space-y-2 text-xs text-ink-muted">
            <li><a href="/pt/calculadora-volume-prisma-retangular" class="hover:text-primary transition-colors">Volume de prisma / caixa</a></li>
            <li><a href="/pt/calculadora-volume-cilindro" class="hover:text-primary transition-colors">Volume de cilindro</a></li>
            <li><a href="/pt/calculadora-volume-cubo" class="hover:text-primary transition-colors">Volume de cubo</a></li>
            <li><a href="/pt/calculadora-volume-esfera" class="hover:text-primary transition-colors">Volume de esfera</a></li>
            <li><a href="/pt/calculadora-volume-cone" class="hover:text-primary transition-colors">Volume de cone</a></li>
            <li><a href="/pt/calculadora-volume-tanque-horizontal" class="hover:text-primary transition-colors">Tanque cilíndrico horizontal</a></li>
            <li><a href="/pt/calculadora-volume-tubo" class="hover:text-primary transition-colors">Tubo e cilindro oco</a></li>
            <li><a href="/pt/calculadora-volume-capsula" class="hover:text-primary transition-colors">Cápsula e tanque bala</a></li>
          </ul>
        ) : isFrench ? (
          <ul class="space-y-2 text-xs text-ink-muted">
            <li><a href="/fr/calculateur-volume-pave-droit" class="hover:text-primary transition-colors">Volume d'un pavé droit</a></li>
            <li><a href="/fr/calculateur-volume-cylindre" class="hover:text-primary transition-colors">Volume d'un cylindre</a></li>
            <li><a href="/fr/calculateur-volume-cube" class="hover:text-primary transition-colors">Volume d'un cube</a></li>
            <li><a href="/fr/calculateur-volume-sphere" class="hover:text-primary transition-colors">Volume d'une sphère</a></li>
            <li><a href="/fr/calculateur-volume-cone" class="hover:text-primary transition-colors">Volume d'un cône</a></li>
            <li><a href="/fr/calculateur-volume-cuve-horizontale" class="hover:text-primary transition-colors">Cuve cylindrique horizontale</a></li>
            <li><a href="/fr/calculateur-volume-tube" class="hover:text-primary transition-colors">Tube et cylindre creux</a></li>
            <li><a href="/fr/calculateur-volume-capsule" class="hover:text-primary transition-colors">Capsule et réservoir bombé</a></li>
          </ul>
        ) : isSpanish ? (
          <ul class="space-y-2 text-xs text-ink-muted">
            <li><a href="/es/calculadora-volumen-prisma-rectangular" class="hover:text-primary transition-colors">Volumen de prisma / caja</a></li>
            <li><a href="/es/calculadora-volumen-cilindro" class="hover:text-primary transition-colors">Volumen de cilindro</a></li>
            <li><a href="/es/calculadora-volumen-cubo" class="hover:text-primary transition-colors">Volumen de cubo</a></li>
            <li><a href="/es/calculadora-volumen-esfera" class="hover:text-primary transition-colors">Volumen de esfera</a></li>
            <li><a href="/es/calculadora-volumen-cono" class="hover:text-primary transition-colors">Volumen de cono</a></li>
            <li><a href="/es/calculadora-volumen-tanque-cilindrico-horizontal" class="hover:text-primary transition-colors">Tanque horizontal (varilla)</a></li>
            <li><a href="/es/calculadora-volumen-tubo" class="hover:text-primary transition-colors">Tubo y cañería cilíndrica</a></li>
            <li><a href="/es/calculadora-volumen-capsula" class="hover:text-primary transition-colors">Cápsula y tanque bala</a></li>
          </ul>
        ) : isGerman ? (
          <ul class="space-y-2 text-xs text-ink-muted">
            <li><a href="/de/quader-volumen-rechner" class="hover:text-primary transition-colors">Quader Volumen Rechner</a></li>
            <li><a href="/de/zylinder-volumen-rechner" class="hover:text-primary transition-colors">Zylinder Volumen Rechner</a></li>
            <li><a href="/de/wuerfel-volumen-rechner" class="hover:text-primary transition-colors">Würfel Volumen Rechner</a></li>
            <li><a href="/de/kugel-volumen-rechner" class="hover:text-primary transition-colors">Kugel Volumen Rechner</a></li>
            <li><a href="/de/kegel-volumen-rechner" class="hover:text-primary transition-colors">Kegel Volumen Rechner</a></li>
            <li><a href="/de/liegender-zylindertank-volumen-rechner" class="hover:text-primary transition-colors">Liegender Zylindertank (Peilstab)</a></li>
            <li><a href="/de/rohr-volumen-rechner" class="hover:text-primary transition-colors">Rohr Volumen Rechner</a></li>
            <li><a href="/de/kapsel-volumen-rechner" class="hover:text-primary transition-colors">Kapsel Volumen Rechner</a></li>
          </ul>
        ) : (
          <ul class="space-y-2 text-xs text-ink-muted">
            <li><a href="/box-volume-calculator" class="hover:text-primary transition-colors">Box Volume Calculator</a></li>
            <li><a href="/cylinder-volume-calculator" class="hover:text-primary transition-colors">Cylinder Volume Calculator</a></li>
            <li><a href="/pool-volume-calculator" class="hover:text-primary transition-colors">Pool Volume Calculator</a></li>
            <li><a href="/cubic-feet-calculator" class="hover:text-primary transition-colors">Cubic Feet (Cu Ft) Calculator</a></li>
            <li><a href="/cube-volume-calculator" class="hover:text-primary transition-colors">Cube Volume Calculator</a></li>
            <li><a href="/sphere-volume-calculator" class="hover:text-primary transition-colors">Sphere Volume Calculator</a></li>
            <li><a href="/cone-volume-calculator" class="hover:text-primary transition-colors">Cone Volume Calculator</a></li>
            <li><a href="/horizontal-tank-volume-calculator" class="hover:text-primary transition-colors">Horizontal Tank Fill Depth</a></li>
            <li><a href="/pipe-volume-calculator" class="hover:text-primary transition-colors">Pipe & Tube Calculator</a></li>
            <li><a href="/capsule-volume-calculator" class="hover:text-primary transition-colors">Capsule & Pressure Tank</a></li>
          </ul>
        )}
      </div>

      <!-- Col 3: All 16 Tools Hub -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-ink mb-3">
          {isPortuguese ? 'As 16 formas' : isFrench ? 'Les 16 formes' : isSpanish ? 'Las 16 figuras' : isGerman ? 'Alle 16 Körper' : 'All Tools Hub'}
        </h3>
        {isPortuguese ? (
          <ul class="space-y-2 text-xs text-ink-muted">
            <li>
              <a href="/pt/calculadoras" aria-label="Diretório das 16 calculadoras" class="font-semibold text-primary hover:underline flex items-center gap-1">
                <span>Diretório das 16 calculadoras</span>
