            <li><a href="/pt/calculadora-volume-piramide-quadrada" class="hover:text-primary transition-colors">Pirâmide de base quadrada</a></li>
            <li><a href="/pt/calculadora-volume-piramide-retangular" class="hover:text-primary transition-colors">Pirâmide retangular</a></li>
            <li><a href="/pt/calculadora-volume-prisma-triangular" class="hover:text-primary transition-colors">Prisma triangular e barraca</a></li>
            <li><a href="/pt/calculadora-volume-prisma-trapezoidal" class="hover:text-primary transition-colors">Prisma trapezoidal e vala</a></li>
            <li><a href="/pt/calculadora-volume-toroide" class="hover:text-primary transition-colors">Toroide e anel O-ring</a></li>
