          <ul class="space-y-2 text-xs text-ink-muted">
            <li>
              <a href="/fr/calculateurs" aria-label="Répertoire des 16 calculateurs" class="font-semibold text-primary hover:underline flex items-center gap-1">
                <span>Répertoire des 16 calculateurs</span>
                <span>→</span>
              </a>
            </li>
            <li><a href="/fr/calculateur-volume-tronc-de-cone" class="hover:text-primary transition-colors">Tronc de cône et seau</a></li>
            <li><a href="/fr/calculateur-volume-calotte-spherique" class="hover:text-primary transition-colors">Calotte sphérique et dôme</a></li>
            <li><a href="/fr/calculateur-volume-pyramide-carree" class="hover:text-primary transition-colors">Pyramide à base carrée</a></li>
            <li><a href="/fr/calculateur-volume-pyramide-rectangulaire" class="hover:text-primary transition-colors">Pyramide rectangulaire</a></li>
            <li><a href="/fr/calculateur-volume-prisme-triangulaire" class="hover:text-primary transition-colors">Prisme triangulaire</a></li>
            <li><a href="/fr/calculateur-volume-prisme-trapezoidal" class="hover:text-primary transition-colors">Prisme trapézoïdal et tranchée</a></li>
            <li><a href="/fr/calculateur-volume-tore" class="hover:text-primary transition-colors">Tore et joint torique</a></li>
            <li><a href="/fr/calculateur-volume-ellipsoide" class="hover:text-primary transition-colors">Ellipsoïde</a></li>
          </ul>
        ) : isSpanish ? (
          <ul class="space-y-2 text-xs text-ink-muted">
            <li>
              <a href="/es/calculadoras" aria-label="Directorio de las 16 herramientas" class="font-semibold text-primary hover:underline flex items-center gap-1">
                <span>Directorio de las 16 herramientas</span>
                <span>→</span>
              </a>
            </li>
            <li><a href="/es/calculadora-volumen-tronco-de-cono" class="hover:text-primary transition-colors">Tronco de cono y cubeta</a></li>
            <li><a href="/es/calculadora-volumen-casquete-esferico" class="hover:text-primary transition-colors">Casquete esférico y domo</a></li>
            <li><a href="/es/calculadora-volumen-piramide-cuadrada" class="hover:text-primary transition-colors">Pirámide de base cuadrada</a></li>
            <li><a href="/es/calculadora-volumen-piramide-rectangular" class="hover:text-primary transition-colors">Pirámide rectangular</a></li>
            <li><a href="/es/calculadora-volumen-prisma-triangular" class="hover:text-primary transition-colors">Prisma triangular y carpa</a></li>
            <li><a href="/es/calculadora-volumen-prisma-trapezoidal" class="hover:text-primary transition-colors">Prisma trapezoidal y zanja</a></li>
            <li><a href="/es/calculadora-volumen-toroide" class="hover:text-primary transition-colors">Toroide y rosquilla (O-ring)</a></li>
            <li><a href="/es/calculadora-volumen-elipsoide" class="hover:text-primary transition-colors">Elipsoide y esferoide</a></li>
          </ul>
        ) : isGerman ? (
          <ul class="space-y-2 text-xs text-ink-muted">
            <li>
              <a href="/de/rechner" aria-label="Verzeichnis aller 16 Volumenrechner" class="font-semibold text-primary hover:underline flex items-center gap-1">
                <span>Verzeichnis aller 16 Rechner</span>
                <span>→</span>
              </a>
            </li>
            <li><a href="/de/kegelstumpf-volumen-rechner" class="hover:text-primary transition-colors">Kegelstumpf und Eimer</a></li>
