---
// Footer.astro - Notion warm canvas-soft document footer
---

<footer class="w-full border-t border-hairline bg-canvas-soft text-ink-secondary mt-16 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8 pb-8 border-b border-hairline">
      <!-- Col 1: Brand Info -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-white border border-hairline shadow-xs flex items-center justify-center p-0.5 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-full h-full" viewBox="0 0 64 64" fill="none">
              <polygon points="32,9 51,20 32,31 13,20" fill="#7DD3FC" opacity="0.9" stroke="#0284C7" stroke-width="2" />
              <polygon points="13,20 32,31 32,53 13,42" fill="#0075DE" stroke="#0052A3" stroke-width="2" />
              <polygon points="32,31 51,20 51,42 32,53" fill="#0284C7" stroke="#0369A1" stroke-width="2" />
              <polygon points="32,23 45,30.5 32,38 19,30.5" fill="#E0F2FE" stroke="#38BDF8" stroke-width="1.2" />
              <line x1="29.5" y1="36" x2="34.5" y2="36" stroke="#FFFFFF" stroke-width="1.8" />
              <line x1="29" y1="41.5" x2="35" y2="41.5" stroke="#FFFFFF" stroke-width="2.2" />
              <line x1="29.5" y1="47" x2="34.5" y2="47" stroke="#FFFFFF" stroke-width="1.8" />
              <line x1="32" y1="31" x2="32" y2="53" stroke="#FFFFFF" stroke-width="1.8" opacity="0.4" />
              <polyline points="13,20 32,31 51,20" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" opacity="0.8" />
            </svg>
          </div>
          <span class="font-bold text-base text-ink tracking-tight">thevolumecalculator.com</span>
        </div>
        <p class="text-xs text-ink-muted max-w-sm leading-relaxed">
          A free, fast, and comprehensive 3D volume calculator supporting 16 geometric shapes, tanks, pipes, and instant multi-unit conversions. Built for students, engineers, architects, and everyday use.
        </p>
        <div class="flex items-center gap-2 pt-1">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] bg-white border border-hairline text-ink-muted font-medium">
            <svg class="w-3 h-3 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
            <span>100% Free & Ad-Free</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] bg-white border border-hairline text-ink-muted font-medium">
            <svg class="w-3 h-3 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
            <span>16 Geometries</span>
          </span>
        </div>
      </div>

      <!-- Col 2: Important Tools -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-ink mb-3">Important Calculators</h3>
        <ul class="space-y-2 text-xs text-ink-muted">
          <li><a href="/box-volume-calculator" class="hover:text-primary transition-colors">Box Volume Calculator</a></li>
          <li><a href="/cylinder-volume-calculator" class="hover:text-primary transition-colors">Cylinder Volume Calculator</a></li>
          <li><a href="/cube-volume-calculator" class="hover:text-primary transition-colors">Cube Volume Calculator</a></li>
          <li><a href="/sphere-volume-calculator" class="hover:text-primary transition-colors">Sphere Volume Calculator</a></li>
          <li><a href="/cone-volume-calculator" class="hover:text-primary transition-colors">Cone Volume Calculator</a></li>
          <li><a href="/horizontal-tank-volume-calculator" class="hover:text-primary transition-colors">Horizontal Tank Fill Depth</a></li>
          <li><a href="/pipe-volume-calculator" class="hover:text-primary transition-colors">Pipe & Tube Calculator</a></li>
          <li><a href="/capsule-volume-calculator" class="hover:text-primary transition-colors">Capsule & Pressure Tank</a></li>
        </ul>
      </div>

      <!-- Col 3: All 16 Tools Hub -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-ink mb-3">All Tools Hub</h3>
        <ul class="space-y-2 text-xs text-ink-muted">
          <li>
            <a href="/calculators" aria-label="Directory of all 16 volume calculator tools" class="font-semibold text-primary hover:underline flex items-center gap-1">
              <span>All 16 Tools Directory</span>
              <span>→</span>
            </a>
          </li>
          <li><a href="/calculators#hub-grid" class="hover:text-primary transition-colors">Complete 3D Geometry Suite</a></li>
          <li><a href="/conical-frustum-volume-calculator" class="hover:text-primary transition-colors">Conical Frustum (Bucket)</a></li>
          <li><a href="/spherical-cap-volume-calculator" class="hover:text-primary transition-colors">Spherical Cap & Dome</a></li>
          <li><a href="/square-pyramid-volume-calculator" class="hover:text-primary transition-colors">Square & Rect. Pyramids</a></li>
          <li><a href="/triangular-prism-volume-calculator" class="hover:text-primary transition-colors">Triangular & Trap. Prisms</a></li>
          <li><a href="/torus-volume-calculator" class="hover:text-primary transition-colors">Torus (Donut / Ring)</a></li>
          <li><a href="/ellipsoid-volume-calculator" class="hover:text-primary transition-colors">Ellipsoid & Spheroid</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-ink-muted">
      <p>© {new Date().getFullYear()} thevolumecalculator.com. All mathematical rights reserved.</p>
      <p class="text-[11px] text-ink-faint">
        Accuracy verified with standard Euclidean mathematical formulas.
      </p>
    </div>
  </div>
</footer>
