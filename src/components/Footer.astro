        <div class="flex items-center gap-2 pt-1">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] bg-white border border-hairline text-ink-muted font-medium">
            <svg class="w-3 h-3 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
            <span>{isHindi ? '100% मुफ्त' : isArabic ? '100% مجاني' : isChinese ? '100% 免费' : isJapanese ? '100% 無料' : isRussian ? '100% Бесплатно' : isItalian ? '100% Gratuito' : isPortuguese ? '100% Gratuito' : isFrench ? '100% Gratuit' : isSpanish ? '100% Gratuito' : isGerman ? '100% Kostenlos' : '100% Free'}</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] bg-white border border-hairline text-ink-muted font-medium">
            <svg class="w-3 h-3 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
            <span>{isHindi ? '16 आकृतियां' : isArabic ? '16 مجسمًا' : isChinese ? '16种立体' : isJapanese ? '16種類の立体' : isRussian ? '16 Фигур 3D' : isItalian ? '16 Forme 3D' : isPortuguese ? '16 Formas 3D' : isFrench ? '16 Formes 3D' : isSpanish ? '16 Geometrías' : isGerman ? '16 Körper' : '16 Geometries'}</span>
          </span>
          <a href={isRussian ? '/ru/metodologiya' : isItalian ? '/it/metodologia' : isPortuguese ? '/pt/metodologia' : isFrench ? '/fr/methodologie' : isSpanish ? '/es/metodologia' : isGerman ? '/de/methodik' : '/methodology'} class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] bg-white border border-hairline text-primary hover:border-primary font-medium transition-colors">
