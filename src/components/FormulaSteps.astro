---
// FormulaSteps.astro - Step-by-step substitution and formula derivation
---

<div id="formula-steps-section" class="w-full bg-white rounded-xl border border-hairline p-5 shadow-xs">
  <div class="flex items-center justify-between mb-3 pb-2 border-b border-hairline">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-accent-sky"></span>
      <h3 class="text-sm font-bold text-ink tracking-tight">Step-by-Step Calculation & Formula</h3>
    </div>
    <span id="active-formula-badge" class="font-mono text-xs font-semibold px-2 py-0.5 rounded bg-primary/10 text-primary border border-primary/20">
      Formula
    </span>
  </div>

  <div id="formula-steps-container" class="space-y-2.5 text-xs">
    <!-- Populated reactively by calculator.ts -->
  </div>
</div>
