  : isChinese
  ? [
      { name: '圆柱体体积', href: '/zh/cylinder-volume-calculator', icon: ICONS.cylinder, note: 'V = π · r² · h' },
      { name: '长方体・纸箱体积', href: '/zh/rectangular-prism-volume-calculator', icon: ICONS.box, note: 'V = l · w · h' },
      { name: '正方体体积', href: '/zh/cube-volume-calculator', icon: ICONS.cube, note: 'V = a³' },
      { name: '球体体积', href: '/zh/sphere-volume-calculator', icon: ICONS.sphere, note: 'V = ⁴⁄₃ · π · r³' },
      { name: '卧式储罐容积', href: '/zh/horizontal-tank-volume-calculator', icon: ICONS.fuel, note: '液位深度换算' },
    ]
  : isJapanese
  ? [
      { name: '円柱の体積', href: '/ja/cylinder-volume-calculator', icon: ICONS.cylinder, note: 'V = π · r² · h' },
      { name: '直方体・箱の体積', href: '/ja/rectangular-prism-volume-calculator', icon: ICONS.box, note: 'V = l · w · h' },
