      { name: '球の体積', href: '/ja/sphere-volume-calculator', icon: ICONS.sphere, note: 'V = ⁴⁄₃ · π · r³' },
      { name: '横型円筒タンク', href: '/ja/horizontal-tank-volume-calculator', icon: ICONS.fuel, note: '液面の深さ換算' },
