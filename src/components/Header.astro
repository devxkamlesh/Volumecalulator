---

<header class="sticky top-0 z-40 w-full border-b border-hairline bg-surface/95 backdrop-blur-md transition-colors">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-14 sm:h-16 flex items-center justify-between gap-2 sm:gap-4">
    <!-- Brand Logo -->
    <a
      href={homeHref}
      class="flex items-center gap-2 sm:gap-2.5 group min-w-0 shrink"
      aria-label="The Volume Calculator Homepage"
    >
      <!-- 3D Cube Icon (Black in Light Mode, White in Dark Mode) -->
      <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-white dark:bg-[#1e1e1e] border border-hairline shadow-xs flex items-center justify-center p-1 transition-transform group-hover:scale-105 shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-full h-full text-black dark:text-white" viewBox="0 0 64 64" fill="none">
          <polygon points="32,6 56,19 32,32 8,19" fill="currentColor" />
          <polygon points="8,23 30.5,35 30.5,57 8,45" fill="currentColor" opacity="0.38" />
          <polygon points="33.5,35 56,23 56,45 33.5,57" fill="currentColor" opacity="0.78" />
        </svg>
      </div>

      <!-- Brand Name -->
      <div class="flex items-center gap-1.5 min-w-0">
        <span class="font-bold text-sm sm:text-base md:text-lg tracking-tight text-ink truncate">
          <span class="hidden sm:inline">The </span>Volume Calculator
        </span>
        <span class="hidden sm:inline-flex text-[10px] sm:text-xs font-semibold px-1.5 py-0.5 rounded-full bg-primary/10 border border-primary/20 text-primary shrink-0">
          .com
        </span>
      </div>
    </a>

    <!-- Desktop Nav Links (Hidden on Mobile) -->
    <nav class="hidden md:flex items-center gap-5 lg:gap-6 text-sm text-ink-secondary font-medium">
      <a href={homeHref} class="hover:text-primary transition-colors whitespace-nowrap">{isHindi ? 'त्वरित कैलकुलेटर' : isArabic ? 'حاسبة سريعة' : isChinese ? '快速计算器' : isJapanese ? 'クイック計算機' : isRussian ? 'Быстрый расчет' : isItalian ? 'Calcolo rapido' : isPortuguese ? 'Cálculo rápido' : isFrench ? 'Calcul rapide' : isSpanish ? 'Calculadora rápida' : isGerman ? 'Schnellrechner' : 'Quick Calculator'}</a>

      <!-- Featured Calculators Sub-Menu Dropdown -->
      <div class="relative group" id="featured-dropdown-container">
        <button
          type="button"
          id="featured-dropdown-btn"
          class="hover:text-primary transition-colors flex items-center gap-1.5 font-medium py-1.5 text-ink-secondary hover:text-ink cursor-pointer"
          aria-expanded="false"
          aria-haspopup="true"
        >
