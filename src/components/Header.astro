      { name: 'Cilindro', href: '/pt/calculadora-volume-cilindro', icon: ICONS.cylinder },
      { name: 'Esfera', href: '/pt/calculadora-volume-esfera', icon: ICONS.sphere },
      { name: 'Cone', href: '/pt/calculadora-volume-cone', icon: ICONS.cone },
      { name: 'Tanque', href: '/pt/calculadora-volume-tanque-horizontal', icon: ICONS.horizontalTank },
      { name: 'Cubo', href: '/pt/calculadora-volume-cubo', icon: ICONS.cube },
    ]
  : isFrench
  ? [
      { name: 'Pavé droit', href: '/fr/calculateur-volume-pave-droit', icon: ICONS.box },
      { name: 'Cylindre', href: '/fr/calculateur-volume-cylindre', icon: ICONS.cylinder },
      { name: 'Sphère', href: '/fr/calculateur-volume-sphere', icon: ICONS.sphere },
      { name: 'Cône', href: '/fr/calculateur-volume-cone', icon: ICONS.cone },
      { name: 'Cuve', href: '/fr/calculateur-volume-cuve-horizontale', icon: ICONS.horizontalTank },
      { name: 'Cube', href: '/fr/calculateur-volume-cube', icon: ICONS.cube },
    ]
  : isSpanish
  ? [
      { name: 'Caja', href: '/es/calculadora-volumen-prisma-rectangular', icon: ICONS.box },
      { name: 'Cilindro', href: '/es/calculadora-volumen-cilindro', icon: ICONS.cylinder },
      { name: 'Esfera', href: '/es/calculadora-volumen-esfera', icon: ICONS.sphere },
      { name: 'Cono', href: '/es/calculadora-volumen-cono', icon: ICONS.cone },
      { name: 'Tanque', href: '/es/calculadora-volumen-tanque-cilindrico-horizontal', icon: ICONS.horizontalTank },
      { name: 'Cubo', href: '/es/calculadora-volumen-cubo', icon: ICONS.cube },
    ]
  : isGerman
  ? [
      { name: 'Quader', href: '/de/quader-volumen-rechner', icon: ICONS.box },
      { name: 'Zylinder', href: '/de/zylinder-volumen-rechner', icon: ICONS.cylinder },
      { name: 'Kugel', href: '/de/kugel-volumen-rechner', icon: ICONS.sphere },
      { name: 'Kegel', href: '/de/kegel-volumen-rechner', icon: ICONS.cone },
      { name: 'Tank', href: '/de/liegender-zylindertank-volumen-rechner', icon: ICONS.horizontalTank },
      { name: 'Würfel', href: '/de/wuerfel-volumen-rechner', icon: ICONS.cube },
    ]
  : [
      { name: 'Box', href: '/box-volume-calculator', icon: ICONS.box },
      { name: 'Cylinder', href: '/cylinder-volume-calculator', icon: ICONS.cylinder },
      { name: 'Sphere', href: '/sphere-volume-calculator', icon: ICONS.sphere },
      { name: 'Cone', href: '/cone-volume-calculator', icon: ICONS.cone },
      { name: 'Tank', href: '/horizontal-tank-volume-calculator', icon: ICONS.horizontalTank },
      { name: 'Cube', href: '/cube-volume-calculator', icon: ICONS.cube },
    ];
