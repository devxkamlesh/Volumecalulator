---
// Header.astro - Clean, fast, minimalist navigation with Featured Tools Sub-Menu
import { ICONS } from '../scripts/icons';
import { LOCALE_CODES, LOCALIZED_HOMES } from '../i18n/home-locales';

const pathname = Astro.url.pathname;
const isSpanish = pathname === '/es' || pathname === '/es/' || pathname.startsWith('/es/');
const isGerman = pathname === '/de' || pathname === '/de/' || pathname.startsWith('/de/');
const isFrench = pathname === '/fr' || pathname === '/fr/' || pathname.startsWith('/fr/');
const isPortuguese = pathname === '/pt' || pathname === '/pt/' || pathname.startsWith('/pt/');
const isItalian = pathname === '/it' || pathname === '/it/' || pathname.startsWith('/it/');
const isRussian = pathname === '/ru' || pathname === '/ru/' || pathname.startsWith('/ru/');
const activeLocale = isRussian ? 'ru' : isItalian ? 'it' : isSpanish ? 'es' : isGerman ? 'de' : isFrench ? 'fr' : isPortuguese ? 'pt' : LOCALE_CODES.find((code) => pathname === `/${code}/` || pathname.startsWith(`/${code}/`)) || 'en';
const activeLanguageName = activeLocale === 'en' ? 'English' : LOCALIZED_HOMES[activeLocale]?.languageName || (isRussian ? 'Русский' : isGerman ? 'Deutsch' : isFrench ? 'Français' : isPortuguese ? 'Português' : isItalian ? 'Italiano' : 'Español');
const languageLinks = [
  { code: 'en', lang: 'en', name: 'English', href: '/' },
  ...LOCALE_CODES.map((code) => ({ code, lang: LOCALIZED_HOMES[code].lang, name: LOCALIZED_HOMES[code].languageName, href: `/${code}/` })),
];

const homeHref = isRussian ? '/ru/' : isItalian ? '/it/' : isPortuguese ? '/pt/' : isSpanish ? '/es/' : isGerman ? '/de/' : isFrench ? '/fr/' : '/';
const hubHref = isRussian ? '/ru/kalkulyatory' : isItalian ? '/it/calcolatori' : isPortuguese ? '/pt/calculadoras' : isSpanish ? '/es/calculadoras' : isGerman ? '/de/rechner' : isFrench ? '/fr/calculateurs' : '/calculators';
const methodologyHref = isRussian ? '/ru/metodologiya' : isItalian ? '/it/metodologia' : isPortuguese ? '/pt/metodologia' : isSpanish ? '/es/metodologia' : isGerman ? '/de/methodik' : isFrench ? '/fr/methodologie' : '/methodology';

// Popular shape shortcuts for mobile menu quick access
const POPULAR_TOOLS = isRussian
  ? [
      { name: 'Коробка', href: '/ru/kalkulyator-obema-parallelepipeda', icon: ICONS.box },
      { name: 'Цилиндр', href: '/ru/kalkulyator-obema-tsilindra', icon: ICONS.cylinder },
      { name: 'Шар', href: '/ru/kalkulyator-obema-shara', icon: ICONS.sphere },
      { name: 'Конус', href: '/ru/kalkulyator-obema-konusa', icon: ICONS.cone },
      { name: 'Резервуар', href: '/ru/kalkulyator-obema-gorizontalnogo-rezervuara', icon: ICONS.horizontalTank },
      { name: 'Куб', href: '/ru/kalkulyator-obema-kuba', icon: ICONS.cube },
    ]
  : isItalian
  ? [
      { name: 'Scatola', href: '/it/calcolatore-volume-prisma-rettangolare', icon: ICONS.box },
      { name: 'Cilindro', href: '/it/calcolatore-volume-cilindro', icon: ICONS.cylinder },
      { name: 'Sfera', href: '/it/calcolatore-volume-sfera', icon: ICONS.sphere },
      { name: 'Cono', href: '/it/calcolatore-volume-cono', icon: ICONS.cone },
      { name: 'Serbatoio', href: '/it/calcolatore-volume-serbatoio-orizzontale', icon: ICONS.horizontalTank },
      { name: 'Cubo', href: '/it/calcolatore-volume-cubo', icon: ICONS.cube },
    ]
  : isPortuguese
  ? [
      { name: 'Caixa', href: '/pt/calculadora-volume-prisma-retangular', icon: ICONS.box },
      { name: 'Cilindro', href: '/pt/calculadora-volume-cilindro', icon: ICONS.cylinder },
      { name: 'Esfera', href: '/pt/calculadora-volume-esfera', icon: ICONS.sphere },
      { name: 'Cone', href: '/pt/calculadora-volume-cone', icon: ICONS.cone },
      { name: 'Tanque', href: '/pt/calculadora-volume-tanque-horizontal', icon: ICONS.horizontalTank },
      { name: 'Cubo', href: '/pt/calculadora-volume-cubo', icon: ICONS.cube },
    ]
  : isFrench
  ? [
      { name: 'Pavé droit', href: '/fr/calculateur-volume-pave-droit', icon: ICONS.box },
      { name: 'Cylindre', href: '/fr/calculateur-volume-cylindre', icon: ICONS.cylinder },
      { name: 'Sphère', href: '/fr/calculateur-volume-sphere', icon: ICONS.sphere },
      { name: 'Cône', href: '/fr/calculateur-volume-cone', icon: ICONS.cone },
      { name: 'Cuve', href: '/fr/calculateur-volume-cuve-horizontale', icon: ICONS.horizontalTank },
      { name: 'Cube', href: '/fr/calculateur-volume-cube', icon: ICONS.cube },
    ]
  : isSpanish
  ? [
      { name: 'Caja', href: '/es/calculadora-volumen-prisma-rectangular', icon: ICONS.box },
      { name: 'Cilindro', href: '/es/calculadora-volumen-cilindro', icon: ICONS.cylinder },
      { name: 'Esfera', href: '/es/calculadora-volumen-esfera', icon: ICONS.sphere },
      { name: 'Cono', href: '/es/calculadora-volumen-cono', icon: ICONS.cone },
      { name: 'Tanque', href: '/es/calculadora-volumen-tanque-cilindrico-horizontal', icon: ICONS.horizontalTank },
      { name: 'Cubo', href: '/es/calculadora-volumen-cubo', icon: ICONS.cube },
    ]
  : isGerman
  ? [
      { name: 'Quader', href: '/de/quader-volumen-rechner', icon: ICONS.box },
      { name: 'Zylinder', href: '/de/zylinder-volumen-rechner', icon: ICONS.cylinder },
      { name: 'Kugel', href: '/de/kugel-volumen-rechner', icon: ICONS.sphere },
      { name: 'Kegel', href: '/de/kegel-volumen-rechner', icon: ICONS.cone },
      { name: 'Tank', href: '/de/liegender-zylindertank-volumen-rechner', icon: ICONS.horizontalTank },
      { name: 'Würfel', href: '/de/wuerfel-volumen-rechner', icon: ICONS.cube },
    ]
  : [
      { name: 'Box', href: '/box-volume-calculator', icon: ICONS.box },
      { name: 'Cylinder', href: '/cylinder-volume-calculator', icon: ICONS.cylinder },
      { name: 'Sphere', href: '/sphere-volume-calculator', icon: ICONS.sphere },
      { name: 'Cone', href: '/cone-volume-calculator', icon: ICONS.cone },
      { name: 'Tank', href: '/horizontal-tank-volume-calculator', icon: ICONS.horizontalTank },
      { name: 'Cube', href: '/cube-volume-calculator', icon: ICONS.cube },
    ];
const featuredTools = isRussian
  ? [
      { name: 'Объем цилиндра', href: '/ru/kalkulyator-obema-tsilindra', icon: ICONS.cylinder, note: 'V = π · r² · h' },
      { name: 'Объем коробки', href: '/ru/kalkulyator-obema-parallelepipeda', icon: ICONS.box, note: 'V = a · b · h' },
      { name: 'Объем куба', href: '/ru/kalkulyator-obema-kuba', icon: ICONS.cube, note: 'V = a³' },
      { name: 'Объем шара', href: '/ru/kalkulyator-obema-shara', icon: ICONS.sphere, note: 'V = ⁴⁄₃ · π · r³' },
      { name: 'Горизонтальный резервуар', href: '/ru/kalkulyator-obema-gorizontalnogo-rezervuara', icon: ICONS.fuel, note: 'Уровень по линейке' },
    ]
  : isItalian
  ? [
      { name: 'Volume cilindro', href: '/it/calcolatore-volume-cilindro', icon: ICONS.cylinder, note: 'V = π · r² · h' },
      { name: 'Volume scatola / prisma', href: '/it/calcolatore-volume-prisma-rettangolare', icon: ICONS.box, note: 'V = l · w · h' },
      { name: 'Volume cubo', href: '/it/calcolatore-volume-cubo', icon: ICONS.cube, note: 'V = a³' },
      { name: 'Volume sfera', href: '/it/calcolatore-volume-sfera', icon: ICONS.sphere, note: 'V = ⁴⁄₃ · π · r³' },
      { name: 'Serbatoio orizzontale', href: '/it/calcolatore-volume-serbatoio-orizzontale', icon: ICONS.fuel, note: 'Livello asta metrica' },
    ]
  : isPortuguese
  ? [
      { name: 'Volume de cilindro', href: '/pt/calculadora-volume-cilindro', icon: ICONS.cylinder, note: 'V = π · r² · h' },
      { name: 'Volume de caixa', href: '/pt/calculadora-volume-prisma-retangular', icon: ICONS.box, note: 'V = c · l · h' },
      { name: 'Volume de cubo', href: '/pt/calculadora-volume-cubo', icon: ICONS.cube, note: 'V = a³' },
      { name: 'Volume de esfera', href: '/pt/calculadora-volume-esfera', icon: ICONS.sphere, note: 'V = ⁴⁄₃ · π · r³' },
      { name: 'Tanque cilíndrico', href: '/pt/calculadora-volume-tanque-horizontal', icon: ICONS.fuel, note: 'Nível pela régua' },
    ]
  : isFrench
  ? [
      { name: 'Volume d\'un cylindre', href: '/fr/calculateur-volume-cylindre', icon: ICONS.cylinder, note: 'V = π · r² · h' },
      { name: 'Volume d\'un pavé droit', href: '/fr/calculateur-volume-pave-droit', icon: ICONS.box, note: 'V = L · l · h' },
      { name: 'Volume d\'un cube', href: '/fr/calculateur-volume-cube', icon: ICONS.cube, note: 'V = a³' },
      { name: 'Volume d\'une sphère', href: '/fr/calculateur-volume-sphere', icon: ICONS.sphere, note: 'V = ⁴⁄₃ · π · r³' },
      { name: 'Cuve cylindrique', href: '/fr/calculateur-volume-cuve-horizontale', icon: ICONS.fuel, note: 'Jauge horizontale' },
    ]
  : isSpanish
  ? [
      { name: 'Volumen de cilindro', href: '/es/calculadora-volumen-cilindro', icon: ICONS.cylinder, note: 'V = π · r² · h' },
      { name: 'Volumen de prisma / caja', href: '/es/calculadora-volumen-prisma-rectangular', icon: ICONS.box, note: 'V = l · w · h' },
      { name: 'Volumen de cubo', href: '/es/calculadora-volumen-cubo', icon: ICONS.cube, note: 'V = a³' },
      { name: 'Volumen de esfera', href: '/es/calculadora-volumen-esfera', icon: ICONS.sphere, note: 'V = ⁴⁄₃ · π · r³' },
      { name: 'Tanque horizontal', href: '/es/calculadora-volumen-tanque-cilindrico-horizontal', icon: ICONS.fuel, note: 'Aforo por varilla' },
    ]
  : isGerman
  ? [
      { name: 'Zylinder Volumen', href: '/de/zylinder-volumen-rechner', icon: ICONS.cylinder, note: 'V = π · r² · h' },
      { name: 'Quader Volumen', href: '/de/quader-volumen-rechner', icon: ICONS.box, note: 'V = l · b · h' },
      { name: 'Würfel Volumen', href: '/de/wuerfel-volumen-rechner', icon: ICONS.cube, note: 'V = a³' },
      { name: 'Kugel Volumen', href: '/de/kugel-volumen-rechner', icon: ICONS.sphere, note: 'V = ⁴⁄₃ · π · r³' },
      { name: 'Liegender Tank', href: '/de/liegender-zylindertank-volumen-rechner', icon: ICONS.fuel, note: 'Peilstab Füllstand' },
    ]
  : [
      { name: 'Cylinder Volume', href: '/cylinder-volume-calculator', icon: ICONS.cylinder, note: 'V = π · r² · h' },
      { name: 'Pool Volume Calculator', href: '/pool-volume-calculator', icon: ICONS.pool, note: 'Gallons & water capacity' },
      { name: 'Cubic Volume', href: '/cubic-feet-calculator', icon: ICONS.cube, note: 'Cu ft & cubic yards' },
      { name: 'Sphere Formula', href: '/sphere-volume-calculator', icon: ICONS.sphere, note: 'V = (4/3) · π · r³' },
      { name: 'Pyramid Volume Formula', href: '/square-pyramid-volume-calculator', icon: ICONS.cone, note: 'V = (1/3) · a² · h' },
    ];
---

<header class="sticky top-0 z-40 w-full border-b border-hairline bg-surface/95 backdrop-blur-md transition-colors">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-14 sm:h-16 flex items-center justify-between gap-2 sm:gap-4">
    <!-- Brand Logo -->
    <a
      href={homeHref}
      class="flex items-center gap-2 sm:gap-2.5 group min-w-0 shrink"
      aria-label="The Volume Calculator Homepage"
    >
      <!-- 3D Cube Icon (Black in Light Mode, White in Dark Mode) -->
      <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-white dark:bg-[#1e1e1e] border border-hairline shadow-xs flex items-center justify-center p-1 transition-transform group-hover:scale-105 shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-full h-full text-black dark:text-white" viewBox="0 0 64 64" fill="none">
          <polygon points="32,6 56,19 32,32 8,19" fill="currentColor" />
          <polygon points="8,23 30.5,35 30.5,57 8,45" fill="currentColor" opacity="0.38" />
          <polygon points="33.5,35 56,23 56,45 33.5,57" fill="currentColor" opacity="0.78" />
        </svg>
      </div>

      <!-- Brand Name -->
      <div class="flex items-center gap-1.5 min-w-0">
        <span class="font-bold text-sm sm:text-base md:text-lg tracking-tight text-ink truncate">
          <span class="hidden sm:inline">The </span>Volume Calculator
        </span>
        <span class="hidden sm:inline-flex text-[10px] sm:text-xs font-semibold px-1.5 py-0.5 rounded-full bg-primary/10 border border-primary/20 text-primary shrink-0">
          .com
        </span>
      </div>
    </a>

    <!-- Desktop Nav Links (Hidden on Mobile) -->
    <nav class="hidden md:flex items-center gap-5 lg:gap-6 text-sm text-ink-secondary font-medium">
      <a href={homeHref} class="hover:text-primary transition-colors whitespace-nowrap">{isRussian ? 'Быстрый расчет' : isItalian ? 'Calcolo rapido' : isPortuguese ? 'Cálculo rápido' : isFrench ? 'Calcul rapide' : isSpanish ? 'Calculadora rápida' : isGerman ? 'Schnellrechner' : 'Quick Calculator'}</a>

      <!-- Featured Calculators Sub-Menu Dropdown -->
      <div class="relative group" id="featured-dropdown-container">
        <button
          type="button"
          id="featured-dropdown-btn"
          class="hover:text-primary transition-colors flex items-center gap-1.5 font-medium py-1.5 text-ink-secondary hover:text-ink cursor-pointer"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>{isRussian ? 'Популярные калькуляторы' : isItalian ? 'Calcolatori in evidenza' : isPortuguese ? 'Calculadoras populares' : isFrench ? 'Calculateurs populaires' : isSpanish ? 'Calculadoras destacadas' : isGerman ? 'Beliebte Rechner' : 'Featured Calculators'}</span>
          <svg class="w-3.5 h-3.5 text-ink-muted group-hover:text-primary transition-transform group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <!-- Sub-Menu Floating Panel -->
        <div
          id="featured-dropdown-menu"
          class="hidden group-hover:block md:group-focus-within:block absolute left-0 top-full pt-2 z-50 w-72"
        >
          <div class="p-2 rounded-2xl bg-surface dark:bg-[#1c1c1e] border border-hairline shadow-xl space-y-1">
            <div class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-ink-muted">
              {isRussian ? 'Популярные калькуляторы и формулы' : isItalian ? 'Strumenti e formule in evidenza' : isPortuguese ? 'Ferramentas e fórmulas populares' : isFrench ? 'Outils et formules populaires' : isSpanish ? 'Herramientas y fórmulas destacadas' : isGerman ? 'Beliebte Rechner und Formeln' : 'Featured Tools & Formulas'}
            </div>

            {featuredTools.map((tool) => (
              <a
                href={tool.href}
                class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-canvas-soft transition-colors group/item"
              >
                <span class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0">
                  <Fragment set:html={tool.icon} />
                </span>
                <div class="min-w-0">
                  <div class="font-semibold text-xs text-ink group-hover/item:text-primary transition-colors">
                    {tool.name}
                  </div>
                  <div class="text-[11px] text-ink-muted font-mono">{tool.note}</div>
                </div>
              </a>
            ))}

            <div class="pt-1.5 mt-1 border-t border-hairline">
              <a
                href={hubHref}
                class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs font-bold text-primary hover:bg-primary/10 transition-colors"
              >
                <span>{isRussian ? 'Смотреть все 16 калькуляторов' : isItalian ? 'Vedi tutti i 16 calcolatori' : isPortuguese ? 'Ver as 16 calculadoras' : isFrench ? 'Voir les 16 calculateurs' : isSpanish ? 'Ver las 16 calculadoras' : isGerman ? 'Alle 16 Rechner ansehen' : 'Browse All 16 Calculators'}</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <a href={hubHref} class="hover:text-primary transition-colors flex items-center gap-1.5 whitespace-nowrap" aria-label={isRussian ? 'Каталог всех 16 калькуляторов объема' : isItalian ? 'Raccolta dei 16 calcolatori' : isPortuguese ? 'Diretório das 16 calculadoras' : isFrench ? 'Répertoire des 16 calculateurs' : isSpanish ? 'Directorio de las 16 calculadoras' : isGerman ? 'Verzeichnis aller 16 Volumenrechner' : 'All 16 Volume Calculators Directory'}>
        <span>{isRussian ? 'Калькуляторы' : isItalian ? 'Calcolatori' : isPortuguese ? 'Calculadoras' : isFrench ? 'Calculateurs' : isSpanish ? 'Calculadoras' : isGerman ? 'Rechner' : 'All Calculators'}</span>
        <span class="text-[10px] px-1.5 py-0.2 rounded-full bg-primary/10 text-primary font-bold">{isRussian ? '16 фигур' : isItalian ? '16 forme' : isPortuguese ? '16 formas' : isFrench ? '16 formes' : isSpanish ? '16 figuras' : isGerman ? '16 Körper' : '16 Tools'}</span>
      </a>

      <!-- Desktop Language Selector -->
      <div class="relative group" id="language-dropdown-container">
        <button
          type="button"
          id="language-dropdown-btn"
          class="min-h-11 hover:text-primary transition-colors flex items-center gap-1.5 font-medium text-ink-secondary cursor-pointer"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="language-dropdown-menu"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg>
          <span>{activeLanguageName}</span>
          <svg class="w-3.5 h-3.5 text-ink-muted transition-transform group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div id="language-dropdown-menu" class="hidden group-hover:block md:group-focus-within:block absolute right-0 top-full pt-2 z-50 w-64">
          <div class="p-2 rounded-2xl bg-surface dark:bg-[#1c1c1e] border border-hairline shadow-xl">
            <div class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-ink-muted">Choose language</div>
            <div class="grid grid-cols-2 gap-1 mt-1">
              {languageLinks.map((language) => (
                <a
                  href={language.href}
                  lang={language.lang}
                  hreflang={language.lang}
                  aria-current={language.code === activeLocale ? 'page' : undefined}
                  class={`min-h-11 px-3 rounded-lg flex items-center text-xs font-semibold transition-colors ${language.code === activeLocale ? 'bg-primary/10 text-primary border border-primary/20' : 'text-ink hover:bg-canvas-soft'}`}
                >
                  {language.name}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </nav>

    <!-- Right Controls -->
    <div class="flex items-center gap-1.5 sm:gap-2.5 shrink-0">
      <!-- Desktop Hub CTA Button -->
      <a
        href={hubHref}
        aria-label={isRussian ? 'Каталог всех 16 калькуляторов объема' : isItalian ? 'Raccolta dei 16 calcolatori' : isPortuguese ? 'Diretório das 16 calculadoras' : isSpanish ? 'Directorio de las 16 calculadoras' : isGerman ? 'Verzeichnis aller 16 Volumenrechner' : 'Directory of all 16 volume calculators'}
        class="hidden sm:inline-flex items-center justify-center px-3.5 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm font-semibold rounded-full bg-primary text-white hover:bg-primary-active active:scale-95 transition-all shadow-xs whitespace-nowrap"
      >
        <span>{isRussian ? 'Все 16 фигур' : isItalian ? 'Tutte le 16 forme' : isPortuguese ? 'As 16 formas' : isSpanish ? 'Las 16 figuras' : isGerman ? 'Alle 16 Körper' : 'All 16 Tools'}</span>
        <span class="ml-1">→</span>
      </a>

      <!-- Theme Toggle Button -->
      <button
        type="button"
        id="theme-toggle-btn"
        class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg text-ink-secondary hover:text-ink hover:bg-canvas-soft border border-hairline transition-colors cursor-pointer flex items-center justify-center shrink-0"
        aria-label="Toggle dark and light theme"
        title="Toggle dark mode"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg class="w-4 h-4 hidden dark:block text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="w-4 h-4 block dark:hidden text-ink-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Mobile Menu Toggle Button (Clean Two-State SVG with Zero Lag) -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="md:hidden w-8 h-8 sm:w-9 sm:h-9 rounded-lg text-ink-secondary hover:text-ink hover:bg-canvas-soft border border-hairline transition-colors cursor-pointer flex items-center justify-center shrink-0"
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
      >
        <!-- Hamburger Icon (Default) -->
        <svg id="hamburger-icon" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <!-- Close Icon (Shown when open) -->
