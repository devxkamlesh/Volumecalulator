            <span>{isHindi ? 'सभी 16 कैलकुलेटर निर्देशिका' : isArabic ? 'فهرس الحاسبات الـ 16' : isChinese ? '全部16种计算器索引' : isJapanese ? '全16種類の計算機一覧' : isRussian ? 'Каталог всех 16 калькуляторов' : isItalian ? 'Raccolta dei 16 calcolatori' : isPortuguese ? 'Diretório das 16 calculadoras' : isFrench ? 'Répertoire des 16 calculateurs' : isSpanish ? 'Directorio de las 16 calculadoras' : isGerman ? 'Verzeichnis aller 16 Rechner' : 'All 16 Calculators Directory'}</span>
          </span>
          <span class="text-xs text-primary font-bold">{isHindi ? '16 आकृतियां →' : isArabic ? '16 مجسم ←' : isChinese ? '16种立体 →' : isJapanese ? '16種類 →' : isRussian ? '16 фигур →' : isItalian ? '16 forme →' : isPortuguese ? '16 formas →' : isFrench ? '16 formes →' : isSpanish ? '16 figuras →' : isGerman ? '16 Körper →' : '16 Tools →'}</span>
        </a>

        <a
          href={methodologyHref}
          class="mobile-nav-link min-h-[42px] px-3 rounded-lg hover:bg-canvas-soft hover:text-primary transition-colors flex items-center justify-between text-sm font-medium text-ink-secondary"
        >
          <span class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
            <span>{isHindi ? 'ज्यामितीय सूत्र और मानक' : isArabic ? 'الصيغ الهندسية المعتمدة' : isChinese ? '计算公式与几何原理' : isJapanese ? '計算方法と公式' : isRussian ? 'Методология и стандарты' : isItalian ? 'Metodologia e standard' : isPortuguese ? 'Metodologia e normas' : isFrench ? 'Méthodologie et normes' : isSpanish ? 'Metodología y estándares' : isGerman ? 'Methodik und Standards' : 'Methodology & Standards'}</span>
          </span>
          <span class="text-xs text-ink-faint">{isHindi ? 'मानक →' : isArabic ? 'المعايير ←' : isChinese ? '公式大全 →' : isJapanese ? '公式一覧 →' : isRussian ? 'Стандарты →' : isItalian ? 'Standard →' : isPortuguese ? 'Normas →' : isFrench ? 'Normes →' : isSpanish ? 'Estándares →' : isGerman ? 'Standards →' : 'Standards →'}</span>
        </a>
      </nav>

      <!-- 5. Language Selector (Mobile) -->
      <div class="pt-3 border-t border-hairline">
        <span class="text-[11px] font-bold uppercase tracking-wider text-ink-muted px-1 block mb-2">Language / Idioma</span>
        <div class="grid grid-cols-2 gap-2">
          {languageLinks.map((language) => (
            <a
              href={language.href}
              lang={language.lang}
              hreflang={language.lang}
              aria-current={language.code === activeLocale ? 'page' : undefined}
              class={`mobile-nav-link min-h-11 px-3 rounded-xl border flex items-center justify-between text-xs font-semibold transition-colors ${language.code === activeLocale ? 'border-primary bg-primary/10 text-primary' : 'border-hairline bg-canvas-soft/70 text-ink hover:border-primary'}`}
            >
              <span>{language.name}</span>
              {language.code === activeLocale && <span aria-hidden="true">✓</span>}
            </a>
          ))}
        </div>
      </div>

      <!-- 6. Mobile Theme Switcher Bar -->
      <div class="pt-3 border-t border-hairline">
        <button
          type="button"
          id="mobile-theme-toggle-btn"
          class="w-full min-h-[44px] px-3 rounded-xl bg-canvas-soft border border-hairline hover:border-ink-muted transition-colors flex items-center justify-between text-xs sm:text-sm font-semibold text-ink-secondary cursor-pointer"
        >
          <span class="flex items-center gap-2.5">
            <svg class="w-4 h-4 hidden dark:block text-amber-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
            <svg class="w-4 h-4 block dark:hidden text-ink-muted shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <span class="text-ink">Appearance</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface border border-hairline text-[11px] font-bold text-ink shadow-2xs">
            <span class="w-2 h-2 rounded-full bg-primary"></span>
            <span class="dark:hidden">Light Mode</span>
            <span class="hidden dark:inline">Dark Mode</span>
          </span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  /* Lightweight, hardware-accelerated drawer transition */
  #mobile-nav-menu:not(.hidden),
  #mobile-lang-menu:not(.hidden) {
    animation: menuFadeIn 0.16s ease-out forwards;
  }

  @keyframes menuFadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // Mobile header language dropdown toggle & dismissals
  const mobileLangBtn = document.getElementById('mobile-lang-btn');
  const mobileLangMenu = document.getElementById('mobile-lang-menu');
  const mobileLangChevron = document.getElementById('mobile-lang-chevron');

  const setMobileLangState = (isOpen: boolean) => {
    if (!mobileLangMenu || !mobileLangBtn) return;
    if (isOpen) {
      if (typeof setMenuState === 'function') {
        setMenuState(false);
      }
      mobileLangMenu.classList.remove('hidden');
      mobileLangChevron?.classList.add('rotate-180');
      mobileLangBtn.setAttribute('aria-expanded', 'true');
    } else {
      mobileLangMenu.classList.add('hidden');
      mobileLangChevron?.classList.remove('rotate-180');
      mobileLangBtn.setAttribute('aria-expanded', 'false');
    }
  };

  if (mobileLangBtn && mobileLangMenu) {
    mobileLangBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isCurrentlyOpen = !mobileLangMenu.classList.contains('hidden');
      setMobileLangState(!isCurrentlyOpen);
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!mobileLangMenu.contains(target) && !mobileLangBtn.contains(target)) {
        setMobileLangState(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        setMobileLangState(false);
      }
    });
  }

  // Mobile navigation drawer toggle & dismissals
  const menuToggle = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  const setMenuState = (isOpen: boolean) => {
    if (!mobileNav || !menuToggle) return;
    if (isOpen) {
      setMobileLangState(false);
      mobileNav.classList.remove('hidden');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      menuToggle.setAttribute('aria-expanded', 'true');
    } else {
      mobileNav.classList.add('hidden');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      menuToggle.setAttribute('aria-expanded', 'false');
    }
  };

  if (menuToggle && mobileNav) {
    menuToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const isCurrentlyOpen = !mobileNav.classList.contains('hidden');
      setMenuState(!isCurrentlyOpen);
    });

    // Close when clicking outside the menu
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!mobileNav.contains(target) && !menuToggle.contains(target)) {
        setMenuState(false);
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        setMenuState(false);
      }
    });
  }

  // Desktop Featured Calculators Sub-Menu Dropdown Toggle & Dismissals
  const dropdownBtn = document.getElementById('featured-dropdown-btn');
  const dropdownMenu = document.getElementById('featured-dropdown-menu');

  if (dropdownBtn && dropdownMenu) {
    dropdownBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = dropdownBtn.getAttribute('aria-expanded') === 'true';
      dropdownBtn.setAttribute('aria-expanded', String(!isExpanded));
      dropdownMenu.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!dropdownMenu.contains(target) && !dropdownBtn.contains(target)) {
        dropdownMenu.classList.add('hidden');
        dropdownBtn.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        dropdownMenu.classList.add('hidden');
        dropdownBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Desktop language dropdown toggle and dismissal
  const languageDropdownBtn = document.getElementById('language-dropdown-btn');
  const languageDropdownMenu = document.getElementById('language-dropdown-menu');

  if (languageDropdownBtn && languageDropdownMenu) {
    languageDropdownBtn.addEventListener('click', (event) => {
      event.stopPropagation();
      const isExpanded = languageDropdownBtn.getAttribute('aria-expanded') === 'true';
      languageDropdownBtn.setAttribute('aria-expanded', String(!isExpanded));
      languageDropdownMenu.classList.toggle('hidden');
    });

    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (!languageDropdownMenu.contains(target) && !languageDropdownBtn.contains(target)) {
        languageDropdownMenu.classList.add('hidden');
        languageDropdownBtn.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        languageDropdownMenu.classList.add('hidden');
        languageDropdownBtn.setAttribute('aria-expanded', 'false');
        languageDropdownBtn.focus();
      }
    });
  }

  // Dark / Light Theme Toggle Handler (Desktop & Mobile synchronized)
  const toggleTheme = () => {
    const isDark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch (_) {}
  };

  const themeToggleBtn = document.getElementById('theme-toggle-btn');
  if (themeToggleBtn) {
    themeToggleBtn.addEventListener('click', toggleTheme);
  }

  const mobileThemeToggleBtn = document.getElementById('mobile-theme-toggle-btn');
  if (mobileThemeToggleBtn) {
    mobileThemeToggleBtn.addEventListener('click', toggleTheme);
  }
</script>
