      { name: 'حجم الكرة', href: '/ar/sphere-volume-calculator', icon: ICONS.sphere, note: 'V = ⁴⁄₃ · π · r³' },
      { name: 'حجم الخزان الأفقي', href: '/ar/horizontal-tank-volume-calculator', icon: ICONS.fuel, note: 'حساب منسوب السائل' },
