      { name: 'Объем коробки', href: '/ru/kalkulyator-obema-parallelepipeda', icon: ICONS.box, note: 'V = a · b · h' },
      { name: 'Объем куба', href: '/ru/kalkulyator-obema-kuba', icon: ICONS.cube, note: 'V = a³' },
      { name: 'Объем шара', href: '/ru/kalkulyator-obema-shara', icon: ICONS.sphere, note: 'V = ⁴⁄₃ · π · r³' },
      { name: 'Горизонтальный резервуар', href: '/ru/kalkulyator-obema-gorizontalnogo-rezervuara', icon: ICONS.fuel, note: 'Уровень по линейке' },
    ]
  : isItalian
  ? [
      { name: 'Volume cilindro', href: '/it/calcolatore-volume-cilindro', icon: ICONS.cylinder, note: 'V = π · r² · h' },
      { name: 'Volume scatola / prisma', href: '/it/calcolatore-volume-prisma-rettangolare', icon: ICONS.box, note: 'V = l · w · h' },
