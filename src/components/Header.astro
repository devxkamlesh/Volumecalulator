      { name: 'Cilindro', href: '/it/calcolatore-volume-cilindro', icon: ICONS.cylinder },
      { name: 'Sfera', href: '/it/calcolatore-volume-sfera', icon: ICONS.sphere },
      { name: 'Cono', href: '/it/calcolatore-volume-cono', icon: ICONS.cone },
