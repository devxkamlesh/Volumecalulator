---
// Header.astro - Clean, fast, minimalist navigation with Featured Tools Sub-Menu
import { ICONS } from '../scripts/icons';
import { LOCALE_CODES, LOCALIZED_HOMES, HUB_URLS } from '../i18n/home-locales';

const pathname = Astro.url.pathname;
const isHindi = pathname === '/hi' || pathname === '/hi/' || pathname.startsWith('/hi/');
const isArabic = pathname === '/ar' || pathname === '/ar/' || pathname.startsWith('/ar/');
const isSpanish = pathname === '/es' || pathname === '/es/' || pathname.startsWith('/es/');
const isGerman = pathname === '/de' || pathname === '/de/' || pathname.startsWith('/de/');
const isFrench = pathname === '/fr' || pathname === '/fr/' || pathname.startsWith('/fr/');
const isPortuguese = pathname === '/pt' || pathname === '/pt/' || pathname.startsWith('/pt/');
const isItalian = pathname === '/it' || pathname === '/it/' || pathname.startsWith('/it/');
const isRussian = pathname === '/ru' || pathname === '/ru/' || pathname.startsWith('/ru/');
const isJapanese = pathname === '/ja' || pathname === '/ja/' || pathname.startsWith('/ja/');
const isChinese = pathname === '/zh' || pathname === '/zh/' || pathname.startsWith('/zh/');
const activeLocale = isHindi ? 'hi' : isArabic ? 'ar' : isChinese ? 'zh' : isJapanese ? 'ja' : isRussian ? 'ru' : isItalian ? 'it' : isSpanish ? 'es' : isGerman ? 'de' : isFrench ? 'fr' : isPortuguese ? 'pt' : LOCALE_CODES.find((code) => pathname === `/${code}/` || pathname.startsWith(`/${code}/`)) || 'en';
const activeLanguageName = activeLocale === 'en' ? 'English' : LOCALIZED_HOMES[activeLocale]?.languageName || (isHindi ? 'हिन्दी' : isArabic ? 'العربية' : isChinese ? '中文' : isJapanese ? '日本語' : isRussian ? 'Русский' : isGerman ? 'Deutsch' : isFrench ? 'Français' : isPortuguese ? 'Português' : isItalian ? 'Italiano' : 'Español');

const isHubPage =
  pathname === '/calculators' || pathname === '/calculators/' ||
  pathname.endsWith('/calculadoras') || pathname.endsWith('/calculadoras/') ||
  pathname.endsWith('/rechner') || pathname.endsWith('/rechner/') ||
  pathname.endsWith('/calculateurs') || pathname.endsWith('/calculateurs/') ||
  pathname.endsWith('/calcolatori') || pathname.endsWith('/calcolatori/') ||
  pathname.endsWith('/kalkulyatory') || pathname.endsWith('/kalkulyatory/') ||
  pathname.endsWith('/keisanki') || pathname.endsWith('/keisanki/') ||
  pathname.endsWith('/jisuanqi') || pathname.endsWith('/jisuanqi/') ||
  pathname.endsWith('/hasibat') || pathname.endsWith('/hasibat/') ||
  pathname.endsWith('/kalkuleta') || pathname.endsWith('/kalkuleta/');

const getHubPath = (code: string) => {
  if (code === 'en') return '/calculators';
  const url = HUB_URLS[code as keyof typeof HUB_URLS];
  return url ? new URL(url).pathname : `/${code}/`;
};

const languageLinks = [
  { code: 'en', lang: 'en', name: 'English', href: isHubPage ? '/calculators' : '/' },
  ...LOCALE_CODES.map((code) => ({
    code,
    lang: LOCALIZED_HOMES[code].lang,
    name: LOCALIZED_HOMES[code].languageName,
    href: isHubPage ? getHubPath(code) : `/${code}/`,
  })),
];

const homeHref = isHindi ? '/hi/' : isArabic ? '/ar/' : isChinese ? '/zh/' : isJapanese ? '/ja/' : isRussian ? '/ru/' : isItalian ? '/it/' : isPortuguese ? '/pt/' : isSpanish ? '/es/' : isGerman ? '/de/' : isFrench ? '/fr/' : '/';
const hubHref = isHindi ? '/hi/kalkuleta' : isArabic ? '/ar/hasibat' : isChinese ? '/zh/jisuanqi' : isJapanese ? '/ja/keisanki' : isRussian ? '/ru/kalkulyatory' : isItalian ? '/it/calcolatori' : isPortuguese ? '/pt/calculadoras' : isSpanish ? '/es/calculadoras' : isGerman ? '/de/rechner' : isFrench ? '/fr/calculateurs' : '/calculators';
const methodologyHref = isRussian ? '/ru/metodologiya' : isItalian ? '/it/metodologia' : isPortuguese ? '/pt/metodologia' : isSpanish ? '/es/metodologia' : isGerman ? '/de/methodik' : isFrench ? '/fr/methodologie' : '/methodology';

// Popular shape shortcuts for mobile menu quick access
const POPULAR_TOOLS = isHindi
  ? [
      { name: 'घनाभ / बॉक्स', href: '/hi/rectangular-prism-volume-calculator', icon: ICONS.box },
      { name: 'बेलन', href: '/hi/cylinder-volume-calculator', icon: ICONS.cylinder },
      { name: 'गोला', href: '/hi/sphere-volume-calculator', icon: ICONS.sphere },
      { name: 'शंकु', href: '/hi/cone-volume-calculator', icon: ICONS.cone },
      { name: 'क्षैतिज टैंक', href: '/hi/horizontal-tank-volume-calculator', icon: ICONS.horizontalTank },
      { name: 'घन', href: '/hi/cube-volume-calculator', icon: ICONS.cube },
    ]
  : isArabic
  ? [
      { name: 'متوازي المستطيلات', href: '/ar/rectangular-prism-volume-calculator', icon: ICONS.box },
      { name: 'الأسطوانة', href: '/ar/cylinder-volume-calculator', icon: ICONS.cylinder },
      { name: 'الكرة', href: '/ar/sphere-volume-calculator', icon: ICONS.sphere },
      { name: 'المخروط', href: '/ar/cone-volume-calculator', icon: ICONS.cone },
      { name: 'الخزان الأفقي', href: '/ar/horizontal-tank-volume-calculator', icon: ICONS.horizontalTank },
      { name: 'المكعب', href: '/ar/cube-volume-calculator', icon: ICONS.cube },
    ]
  : isChinese
  ? [
      { name: '长方体・纸箱', href: '/zh/rectangular-prism-volume-calculator', icon: ICONS.box },
      { name: '圆柱体', href: '/zh/cylinder-volume-calculator', icon: ICONS.cylinder },
      { name: '球体', href: '/zh/sphere-volume-calculator', icon: ICONS.sphere },
      { name: '圆锥体', href: '/zh/cone-volume-calculator', icon: ICONS.cone },
      { name: '卧式储罐', href: '/zh/horizontal-tank-volume-calculator', icon: ICONS.horizontalTank },
      { name: '正方体', href: '/zh/cube-volume-calculator', icon: ICONS.cube },
    ]
  : isJapanese
  ? [
      { name: '直方体・箱', href: '/ja/rectangular-prism-volume-calculator', icon: ICONS.box },
      { name: '円柱', href: '/ja/cylinder-volume-calculator', icon: ICONS.cylinder },
      { name: '球', href: '/ja/sphere-volume-calculator', icon: ICONS.sphere },
      { name: '円錐', href: '/ja/cone-volume-calculator', icon: ICONS.cone },
      { name: '横型タンク', href: '/ja/horizontal-tank-volume-calculator', icon: ICONS.horizontalTank },
      { name: '立方体', href: '/ja/cube-volume-calculator', icon: ICONS.cube },
    ]
  : isRussian
  ? [
