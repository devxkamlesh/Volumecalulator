---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { SIMPLE_SHAPES } from '../scripts/simple-calculator';
import { HOME_ALTERNATES, LOCALE_CODES, LOCALIZED_HOMES, type LocalizedHomeContent } from '../i18n/home-locales';
import { LOCALIZED_FAQS } from '../i18n/localized-faqs';

interface Props { content: LocalizedHomeContent }
const { content } = Astro.props;
const canonical = `https://thevolumecalculator.com/${content.code}/`;
const localizedFaqs = LOCALIZED_FAQS[content.code];
const shapeIds = ['box', 'cylinder', 'sphere', 'cube', 'cone'] as const;
const schemaGraph = [
  {
    '@type': 'SoftwareApplication',
    'name': content.h1,
    'applicationCategory': 'EducationalApplication',
    'operatingSystem': 'All',
    'inLanguage': content.lang,
    'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'USD' },
    'description': content.description,
    'url': canonical,
  },
  {
    '@type': 'FAQPage',
    'inLanguage': content.lang,
    'mainEntity': localizedFaqs.map((faq) => ({
      '@type': 'Question',
      'name': faq.question,
      'acceptedAnswer': { '@type': 'Answer', 'text': faq.answer },
    })),
  },
];
const calculatorConfig = {
  locale: content.lang,
  defaultSystem: 'metric',
  defaultOutputUnit: 'L',
  labels: {
    result: content.resultLabel,
    clear: content.clearLabel,
    copy: content.copyLabel,
    metric: content.metricLabel,
    imperial: content.imperialLabel,
  },
  shapeNames: content.shapeNames,
  inputLabels: {
    es: { length: 'Largo', width: 'Ancho', height: 'Alto', radius: 'Radio', side: 'Lado' },
    pt: { length: 'Comprimento', width: 'Largura', height: 'Altura', radius: 'Raio', side: 'Lado' },
    de: { length: 'Länge', width: 'Breite', height: 'Höhe', radius: 'Radius', side: 'Kantenlänge' },
    fr: { length: 'Longueur', width: 'Largeur', height: 'Hauteur', radius: 'Rayon', side: 'Côté' },
    ru: { length: 'Длина', width: 'Ширина', height: 'Высота', radius: 'Радиус', side: 'Ребро' },
    ja: { length: '長さ', width: '幅', height: '高さ', radius: '半径', side: '一辺' },
    zh: { length: '长度', width: '宽度', height: '高度', radius: '半径', side: '边长' },
    it: { length: 'Lunghezza', width: 'Larghezza', height: 'Altezza', radius: 'Raggio', side: 'Lato' },
    ar: { length: 'الطول', width: 'العرض', height: 'الارتفاع', radius: 'نصف القطر', side: 'طول الضلع' },
    hi: { length: 'लंबाई', width: 'चौड़ाई', height: 'ऊँचाई', radius: 'त्रिज्या', side: 'भुजा' },
  }[content.code],
};
---

<Layout title={content.title} description={content.description} keywords={content.keywords} canonical={canonical} ogType="website" ogImage="/og-image.png" ogImageAlt={content.title} schemaGraph={schemaGraph} lang={content.lang} dir={content.dir} ogLocale={content.ogLocale} ogLocaleAlternates={['en_US', ...LOCALE_CODES.map((code) => LOCALIZED_HOMES[code].ogLocale)]} alternates={HOME_ALTERNATES}>
  <Header />
  <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10">
    <section class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-white border border-hairline text-primary shadow-xs">
        <span class="w-2 h-2 rounded-full bg-accent-green"></span>{content.badge}
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-ink tracking-tight leading-tight">{content.h1}</h1>
      <p class="text-sm sm:text-base text-ink-secondary leading-relaxed">{content.intro}</p>
    </section>

    <section id="localized-calculator" class="bg-white rounded-2xl border border-hairline p-5 sm:p-8 shadow-xs space-y-6" data-locale-calculator>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-ink">{content.calculatorTitle}</h2>
          <p class="text-xs text-ink-muted mt-1">{content.calculateLabel}</p>
        </div>
        <div class="inline-flex p-1 rounded-xl bg-canvas-soft border border-hairline" aria-label="Unit system">
          <button type="button" class="locale-system-btn min-h-11 px-4 py-2 rounded-lg text-xs font-bold bg-primary text-white" data-system="metric" aria-pressed="true">{content.metricLabel}</button>
          <button type="button" class="locale-system-btn min-h-11 px-4 py-2 rounded-lg text-xs font-bold text-ink-muted" data-system="imperial" aria-pressed="false">{content.imperialLabel}</button>
        </div>
      </div>

      <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-hairline">
        {shapeIds.map((id, index) => (
          <button type="button" class={`locale-shape-btn min-h-11 inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap ${index === 0 ? 'bg-primary text-white' : 'bg-white border border-hairline text-ink-secondary'}`} data-shape={id} aria-pressed={index === 0 ? 'true' : 'false'}>
            <span class="w-4 h-4"><Fragment set:html={SIMPLE_SHAPES[id].icon} /></span>
            {content.shapeNames[id]}
          </button>
        ))}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
        <div class="md:col-span-7 space-y-4">
          <h3 id="locale-shape-title" class="font-bold text-lg text-ink">{content.shapeNames.box}</h3>
          <div id="locale-inputs" class="space-y-4"></div>
          <button id="locale-clear" type="button" class="min-h-11 px-4 py-2 rounded-lg bg-canvas-soft border border-hairline text-xs font-semibold text-ink">{content.clearLabel}</button>
        </div>
        <div class="md:col-span-5 p-5 rounded-xl bg-canvas-soft border border-hairline space-y-4">
          <div role="status" aria-live="polite" aria-atomic="true">
            <span class="text-xs font-bold uppercase tracking-wider text-ink-muted">{content.resultLabel}</span>
            <div class="flex items-baseline gap-2 mt-2" dir="ltr">
              <span id="locale-result" class="text-4xl font-extrabold text-ink font-mono">0.00</span>
              <span id="locale-result-unit" class="font-bold text-primary">L</span>
            </div>
          </div>
          <label for="locale-output-unit" class="sr-only">{content.resultLabel}</label>
          <select id="locale-output-unit" class="w-full min-h-11 px-3 rounded-lg bg-white border border-hairline text-sm font-semibold text-ink">
            <option value="L" selected>Liters (L)</option><option value="m3">m³</option><option value="gal">US gal</option><option value="ft3">ft³</option><option value="yd3">yd³</option>
          </select>
          <button id="locale-copy" type="button" class="min-h-11 w-full px-4 py-2 rounded-lg bg-primary text-white text-xs font-bold">{content.copyLabel}</button>
        </div>
      </div>
      <script id="locale-calculator-config" type="application/json" set:html={JSON.stringify(calculatorConfig)} />
    </section>

    <article class="bg-white rounded-2xl border border-hairline p-6 sm:p-9 shadow-xs space-y-8">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-ink">{content.guideTitle}</h2>
      {content.sections.map((section) => (
        <section class="space-y-3">
          <h3 class="text-xl font-bold text-ink">{section.heading}</h3>
          {section.paragraphs.map((paragraph) => <p class="text-sm sm:text-base text-ink-secondary leading-relaxed">{paragraph}</p>)}
        </section>
      ))}
      <section class="space-y-3">
        <h2 class="text-xl font-bold text-ink">{content.faqTitle}</h2>
        {localizedFaqs.map((faq) => (
          <details class="rounded-xl border border-hairline p-4 open:bg-canvas-soft/30">
            <summary class="font-bold text-sm text-ink cursor-pointer">{faq.question}</summary>
            <p class="mt-3 pt-3 border-t border-hairline text-sm text-ink-secondary">{faq.answer}</p>
          </details>
        ))}
      </section>
    </article>

    <nav aria-label="Language" class="bg-white rounded-2xl border border-hairline p-5 shadow-xs">
      <h2 class="text-sm font-bold text-ink mb-3">Languages</h2>
      <div class="flex flex-wrap gap-2">
        <a href="/" hreflang="en" lang="en" class="min-h-11 inline-flex items-center px-3 rounded-lg border border-hairline text-xs font-semibold text-ink">English</a>
        {LOCALE_CODES.map((code) => <a href={`/${code}/`} hreflang={LOCALIZED_HOMES[code].lang} lang={LOCALIZED_HOMES[code].lang} class={`min-h-11 inline-flex items-center px-3 rounded-lg border text-xs font-semibold ${code === content.code ? 'border-primary bg-primary/10 text-primary' : 'border-hairline text-ink'}`}>{LOCALIZED_HOMES[code].languageName}</a>)}
      </div>
    </nav>
  </main>
  <Footer />
  <script src="../scripts/localized-calculator.ts"></script>
</Layout>
