---
// SimpleCalculator.astro - Friendly, intuitive calculator for everyday users
import { SIMPLE_SHAPES } from '../scripts/simple-calculator';
import { ICONS } from '../scripts/icons';

const shapes = Object.values(SIMPLE_SHAPES);
---

<div id="simple-calculator-card" class="w-full max-w-4xl mx-auto bg-white rounded-2xl border border-hairline p-5 sm:p-8 shadow-xs">
  <!-- Top Shape Tabs with Clean Vector SVGs -->
  <div class="flex items-center gap-2 overflow-x-auto pb-3 mb-6 border-b border-hairline scrollbar-none">
    {shapes.map((s, idx) => (
      <button
        type="button"
        class={`simple-shape-tab inline-flex items-center gap-2 px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all cursor-pointer whitespace-nowrap ${
          idx === 0
            ? 'bg-primary text-white shadow-xs'
            : 'bg-white text-ink-secondary border border-hairline hover:border-ink-muted'
        }`}
        data-shape={s.id}
      >
        <span class="w-4 h-4 flex items-center justify-center shrink-0">
          <Fragment set:html={s.icon} />
        </span>
        <span>{s.name}</span>
      </button>
    ))}
  </div>

  <!-- Shape Header & Description -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
    <div>
      <h2 id="simple-shape-title" class="text-xl sm:text-2xl font-bold text-ink tracking-tight flex items-center gap-2.5">
        <span class="w-8 h-8 rounded-lg bg-primary/10 border border-primary/20 text-primary flex items-center justify-center shrink-0">
          <Fragment set:html={ICONS.box} />
        </span>
        <span>Rectangular Box</span>
      </h2>
      <p id="simple-shape-desc" class="text-xs sm:text-sm text-ink-secondary mt-1">
        Calculates the volume of boxes, shipping packages, rooms, and rectangular containers.
      </p>
    </div>
    <div class="flex items-center gap-2 self-start sm:self-auto">
      <a
        id="simple-dedicated-link"
        href="/box-volume-calculator"
        class="inline-flex items-center gap-1.5 px-3 py-1 sm:py-1.5 rounded-full text-[11px] sm:text-xs font-semibold bg-canvas-soft border border-hairline hover:border-primary text-ink hover:text-primary transition-all shadow-2xs"
        title="Open standalone Rectangular Box volume calculator page"
        aria-label="Open standalone Rectangular Box volume calculator page"
      >
        <span class="hidden xs:inline">Dedicated Tool Page</span>
        <span class="xs:hidden">Dedicated Tool</span>
        <span class="text-primary font-bold">→</span>
      </a>
      <button
        type="button"
        id="simple-reset-btn"
        class="text-xs font-medium px-3 py-1.5 rounded-md bg-canvas-soft border border-hairline text-ink-muted hover:text-ink hover:border-ink-muted transition-colors cursor-pointer"
        title="Clear all fields"
      >
        Clear
      </button>
    </div>
  </div>

  <!-- Grid: Inputs on Left, Output on Right -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 sm:gap-8 items-start">
    <!-- Left Column: Inputs Form (7 cols on md) -->
    <div id="simple-inputs-container" class="md:col-span-7 flex flex-col gap-4">
      <!-- Populated dynamically by simple-calculator.ts -->
    </div>

    <!-- Right Column: Results (5 cols on md) -->
    <div class="md:col-span-5 flex flex-col gap-4 p-5 sm:p-6 rounded-xl bg-canvas-soft border border-hairline">
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold uppercase tracking-wider text-ink-muted">Calculated Volume</span>
          <button
            type="button"
            id="simple-copy-btn"
            class="text-xs font-medium px-2.5 py-0.5 rounded bg-white border border-hairline hover:border-ink-muted text-ink active:scale-95 transition-all cursor-pointer"
          >
            Copy
          </button>
        </div>

        <!-- Big Volume Display -->
        <div class="my-2">
          <span id="simple-volume-value" class="text-4xl sm:text-5xl font-extrabold text-ink tracking-tight font-mono block leading-none">
            0.00
          </span>
          <div class="mt-3 flex items-center gap-2">
            <label for="simple-output-unit-select" class="text-xs font-semibold text-ink-muted">Volume Unit:</label>
            <select
              id="simple-output-unit-select"
              class="px-2.5 py-1 text-xs font-semibold rounded-md bg-white border border-hairline text-primary focus:outline-none focus:ring-2 focus:ring-primary cursor-pointer shadow-2xs"
            >
              <option value="gal" selected>US Gallons (gal)</option>
              <option value="L">Liters (L)</option>
              <option value="ft3">Cubic Feet (cu ft)</option>
              <option value="m3">Cubic Meters (m³)</option>
              <option value="in3">Cubic Inches (cu in)</option>
            </select>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Big Callout to the Universal Powerhouse Page -->
  <div class="mt-8 pt-6 border-t border-hairline flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-xl bg-gradient-to-r from-primary/5 via-canvas-soft to-primary/5 border border-primary/20">
    <div class="flex items-center gap-3.5">
      <div class="w-10 h-10 rounded-xl bg-primary text-white flex items-center justify-center font-bold text-lg shadow-sm shrink-0">
        <Fragment set:html={ICONS.lightning} />
      </div>
      <div>
        <h3 class="font-bold text-sm sm:text-base text-ink leading-tight">
          Need Tanks, Pipes, Pyramids, or Specialized Shapes?
        </h3>
        <p class="text-xs text-ink-muted mt-0.5">
          Explore our complete directory of all 16 dedicated 3D tools with instant step-by-step arithmetic.
        </p>
      </div>
    </div>
    <a
      href="/calculators"
      class="inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold bg-primary text-white hover:bg-primary-active active:scale-95 transition-all shadow-xs shrink-0 whitespace-nowrap"
    >
      <span>Browse All 16 Tools Hub</span>
      <span>→</span>
    </a>
  </div>
</div>
