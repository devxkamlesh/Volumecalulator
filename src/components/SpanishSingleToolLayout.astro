---
interface Props {
  slug: string;
}

const { slug } = Astro.props;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SHAPES } from '../scripts/shapes';
import { SPANISH_TOOLS } from '../i18n/spanish-tools';
import { GERMAN_TOOLS } from '../i18n/german-tools';
import { FRENCH_TOOLS } from '../i18n/french-tools';
import { PORTUGUESE_TOOLS } from '../i18n/portuguese-tools';
import { ITALIAN_TOOLS } from '../i18n/italian-tools';
import { RUSSIAN_TOOLS } from '../i18n/russian-tools';
import { getShapeSvg } from '../scripts/diagrams';

const tool = SPANISH_TOOLS[slug];
if (!tool) {
  throw new Error(`Spanish tool detail not found for slug: ${slug}`);
}

const shape = SHAPES[tool.shapeId];
if (!shape) {
  throw new Error(`Shape definition not found for ID: ${tool.shapeId}`);
}

const diagramSvg = getShapeSvg(shape.id);

const units = [
  { id: 'cm', label: 'Centímetros (cm)' },
  { id: 'm', label: 'Metros (m)' },
  { id: 'mm', label: 'Milímetros (mm)' },
  { id: 'in', label: 'Pulgadas (in)' },
  { id: 'ft', label: 'Pies (ft)' },
  { id: 'yd', label: 'Yardas (yd)' },
];

const outputUnits = [
  { id: 'l', label: 'Litros (l)' },
  { id: 'm3', label: 'Metros cúbicos (m³)' },
  { id: 'cm3', label: 'Centímetros cúbicos (cm³)' },
  { id: 'gal', label: 'Galones (gal)' },
  { id: 'cu_ft', label: 'Pies cúbicos (ft³)' },
  { id: 'cu_in', label: 'Pulgadas cúbicas (in³)' },
  { id: 'cu_yd', label: 'Yardas cúbicas (yd³)' },
];

const relatedTools = tool.relatedSpanishSlugs.map((relatedSlug) => {
  const related = SPANISH_TOOLS[relatedSlug];
  if (!related) throw new Error(`Related Spanish tool not found: ${relatedSlug}`);
  return related;
});

const canonicalUrl = `https://thevolumecalculator.com/es/${tool.slug}`;
const englishUrl = `https://thevolumecalculator.com/${tool.englishSlug}`;
const germanCounterpart = Object.values(GERMAN_TOOLS).find((gt) => gt.englishSlug === tool.englishSlug);
const frenchCounterpart = Object.values(FRENCH_TOOLS).find((ft) => ft.englishSlug === tool.englishSlug);
const portugueseCounterpart = Object.values(PORTUGUESE_TOOLS).find((pt) => pt.englishSlug === tool.englishSlug);
const italianCounterpart = Object.values(ITALIAN_TOOLS).find((it) => it.englishSlug === tool.englishSlug);
const russianCounterpart = Object.values(RUSSIAN_TOOLS).find((rt) => rt.englishSlug === tool.englishSlug);

const alternates = [
  { hreflang: 'en', href: englishUrl },
  { hreflang: 'es', href: canonicalUrl },
  ...(germanCounterpart ? [{ hreflang: 'de', href: `https://thevolumecalculator.com/de/${germanCounterpart.slug}` }] : []),
  ...(frenchCounterpart ? [{ hreflang: 'fr', href: `https://thevolumecalculator.com/fr/${frenchCounterpart.slug}` }] : []),
  ...(portugueseCounterpart ? [{ hreflang: 'pt', href: `https://thevolumecalculator.com/pt/${portugueseCounterpart.slug}` }] : []),
  ...(italianCounterpart ? [{ hreflang: 'it', href: `https://thevolumecalculator.com/it/${italianCounterpart.slug}` }] : []),
  ...(russianCounterpart ? [{ hreflang: 'ru', href: `https://thevolumecalculator.com/ru/${russianCounterpart.slug}` }] : []),
  { hreflang: 'x-default', href: englishUrl },
];

const ogLocaleAlternates = ['es_MX', 'es_CO', 'es_AR', 'es_PE', 'es_CL', 'es_US'];

const toolSchemaGraph: any[] = [
  {
    '@type': 'SoftwareApplication',
    'name': tool.h1,
    'applicationCategory': 'EducationalApplication',
    'operatingSystem': 'Any',
    'offers': {
      '@type': 'Offer',
      'price': '0',
      'priceCurrency': 'USD',
    },
    'description': tool.metaDescription,
    'url': canonicalUrl,
  },
  {
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'Inicio',
        'item': 'https://thevolumecalculator.com/es/',
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': 'Calculadoras',
        'item': 'https://thevolumecalculator.com/es/calculadoras',
      },
      {
        '@type': 'ListItem',
        'position': 3,
        'name': tool.shapeName,
        'item': canonicalUrl,
      },
    ],
  },
  {
    '@type': 'FAQPage',
    'mainEntity': tool.faqs.map((faq) => ({
      '@type': 'Question',
      'name': faq.question,
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': faq.answer,
      },
    })),
  },
];
---

<Layout
  title={`${tool.title} | thevolumecalculator.com`}
  description={tool.metaDescription}
  keywords={tool.keywords}
  canonical={canonicalUrl}
  lang="es"
  dir="ltr"
  ogLocale="es_ES"
  ogLocaleAlternates={ogLocaleAlternates}
  alternates={alternates}
  schemaGraph={toolSchemaGraph}
>
  <Header />

  <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-8 sm:space-y-12">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-1.5 text-xs text-ink-muted" aria-label="Breadcrumb">
      <a href="/es/" class="hover:text-primary transition-colors">Inicio</a>
      <span>/</span>
      <a href="/es/calculadoras" class="hover:text-primary transition-colors">Calculadoras</a>
      <span>/</span>
      <span class="text-ink font-semibold">{tool.shapeName}</span>
    </nav>

    <!-- Hero Header -->
    <section class="space-y-3">
      <div class="flex flex-wrap items-center gap-2">
        <span class={`text-[11px] font-bold px-2.5 py-0.5 rounded-full border whitespace-nowrap shrink-0 ${shape.badgeColor}`}>
          {tool.categoryLabel}
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-ink tracking-tight flex items-center gap-3">
        <span class="w-9 h-9 sm:w-11 sm:h-11 rounded-xl bg-primary/10 border border-primary/20 text-primary flex items-center justify-center shrink-0">
          <Fragment set:html={shape.iconSvg} />
        </span>
        <span>{tool.h1}</span>
      </h1>

      <p class="text-sm sm:text-base text-ink-secondary max-w-3xl leading-relaxed">
        {tool.shortTagline} Ingresa las medidas a continuación para calcular el volumen al instante en litros, metros cúbicos o galones.
      </p>
    </section>

    <!-- Main Interactive Calculator Card -->
    <div
      id="single-tool-card"
      data-shape-id={shape.id}
      data-shape-name={tool.shapeName}
      data-lang="es"
      data-default-unit="l"
      class="bg-white rounded-2xl border border-hairline p-5 sm:p-7 shadow-xs space-y-6"
    >
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-hairline">
        <div>
          <h2 class="text-lg font-bold text-ink tracking-tight">
            Ingresar dimensiones
          </h2>
          <p class="text-xs text-ink-muted mt-0.5">
            Mide tu figura y selecciona la unidad de cada dimensión
          </p>
        </div>
        <button
          type="button"
          id="single-clear-btn"
          class="text-xs font-semibold px-3 py-1.5 rounded-md bg-canvas-soft border border-hairline text-ink-muted hover:text-ink hover:border-ink-muted transition-colors cursor-pointer self-start sm:self-auto"
        >
          Borrar todo
        </button>
      </div>

      <!-- Responsive Grid: Form Inputs and Diagram -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-center">
        <!-- Inputs Form Column -->
        <div class="lg:col-span-7 flex flex-col gap-4">
          {shape.inputs.map((input) => {
            const inputLabel = tool.inputLabels[input.id] || input.label;
            const defaultUnit = input.defaultUnit === 'in' || input.defaultUnit === 'ft' ? 'cm' : input.defaultUnit;
            return (
              <div class="flex flex-col gap-1.5">
                <label for={`tool-in-${input.id}`} class="text-xs sm:text-sm font-bold text-ink flex items-center justify-between">
                  <span class="flex items-center gap-1.5">
                    <span class="w-5 h-5 rounded bg-canvas-soft border border-hairline text-ink-muted font-mono font-bold text-xs flex items-center justify-center">
                      {input.symbol}
                    </span>
                    <span>{inputLabel}</span>
                  </span>
                  <span class="text-[11px] font-normal text-ink-faint">
                    símbolo: {input.symbol}
                  </span>
                </label>

                <div class="flex items-center gap-2">
                  <input
                    type="number"
                    id={`tool-in-${input.id}`}
                    data-id={input.id}
                    value=""
                    placeholder="0"
                    step="any"
                    min="0"
                    class="w-full px-3.5 py-2.5 text-base font-mono rounded-xl bg-canvas-soft/40 border border-hairline text-ink focus:outline-none focus:ring-2 focus:ring-primary focus:bg-white transition-all shadow-xs"
                  />
                  <label for={`tool-unit-${input.id}`} class="sr-only">Unidad de {inputLabel}</label>
                  <select
                    id={`tool-unit-${input.id}`}
                    aria-label={`Unidad de ${inputLabel}`}
                    class="px-3 py-2.5 text-xs sm:text-sm font-semibold rounded-xl bg-canvas-soft border border-hairline text-ink focus:outline-none focus:ring-2 focus:ring-primary cursor-pointer shrink-0"
                  >
                    {units.map((u) => (
                      <option value={u.id} selected={u.id === defaultUnit}>
                        {u.label}
                      </option>
                    ))}
                  </select>
                </div>
              </div>
            );
          })}
          <p id="single-calculation-error" class="hidden rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-700 dark:border-red-900 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="assertive" aria-atomic="true"></p>
        </div>

        <!-- Wireframe Diagram Visual Guide Column -->
        <div class="lg:col-span-5 flex flex-col items-center justify-center p-4 rounded-xl bg-canvas-soft border border-hairline">
          <div class="w-full flex items-center justify-center">
            <Fragment set:html={diagramSvg} />
          </div>
          <span class="text-[11px] font-medium text-ink-muted mt-2 text-center">
            Guía de referencia de dimensiones para {tool.shapeName}
          </span>
        </div>
      </div>

      <!-- Output Results Card -->
      <div class="p-5 sm:p-6 rounded-xl bg-canvas-soft border border-hairline flex flex-col gap-4">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-ink-muted">
            Volumen calculado
          </span>
          <button
            type="button"
            id="single-copy-btn"
            class="text-xs font-semibold px-3 py-1 rounded bg-white border border-hairline hover:border-ink-muted text-ink active:scale-95 transition-all cursor-pointer shadow-xs"
          >
            Copiar resultado
          </button>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2" role="status" aria-live="polite" aria-atomic="true">
          <!-- Big Volume Number Display -->
          <div class="my-1">
            <span
              id="single-volume-value"
              class="text-4xl sm:text-5xl font-extrabold text-ink tracking-tight font-mono block leading-none"
            >
              0.00
            </span>
          </div>

          <!-- Output Unit Selector -->
          <div class="flex items-center gap-2 self-start sm:self-auto">
            <label for="single-output-unit" class="text-xs font-semibold text-ink-muted">
              Mostrar en:
            </label>
            <select
              id="single-output-unit"
              class="px-3 py-1.5 text-xs sm:text-sm font-bold rounded-lg bg-white border border-hairline text-ink focus:outline-none focus:ring-2 focus:ring-primary cursor-pointer shadow-xs"
            >
              {outputUnits.map((ou) => (
                <option value={ou.id} selected={ou.id === 'l'}>
                  {ou.label}
                </option>
              ))}
            </select>
          </div>
        </div>

        <!-- Surface Area Secondary Result (if applicable) -->
        <div class="pt-3 border-t border-hairline flex items-center justify-between text-xs text-ink-muted">
          <span>Área de superficie estimada:</span>
          <span id="single-surface-area" class="font-mono font-bold text-ink">
            —
          </span>
        </div>
      </div>

      <!-- Step-by-Step Arithmetic Substitution Card -->
      <div id="single-steps-card" class="hidden rounded-xl border border-hairline bg-canvas-soft/60 p-4 space-y-3">
        <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-ink">
          <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 11l3 3L22 4"></path>
            <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path>
          </svg>
          <span>Sustitución aritmética paso a paso</span>
        </div>
        <div id="single-steps-container" class="space-y-2"></div>
      </div>
    </div>

    <!-- How to Calculate Section -->
    <section class="space-y-4 pt-4 border-t border-hairline">
      <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
        Cómo calcular el volumen de un {tool.shapeName.toLowerCase()}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {tool.howToCalculate.map((step, idx) => (
          <div class="p-4 rounded-xl bg-canvas-soft border border-hairline flex flex-col gap-2">
            <span class="w-6 h-6 rounded-full bg-primary text-white font-mono font-bold text-xs flex items-center justify-center shrink-0">
              {idx + 1}
            </span>
            <p class="text-xs sm:text-sm text-ink-secondary leading-relaxed">
              {step}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Formula Detail Box -->
    <section class="p-5 sm:p-6 rounded-2xl bg-canvas-soft border border-hairline space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-bold uppercase tracking-wider text-ink">
          Fórmula matemática
        </h2>
        <span class="text-[11px] font-mono text-ink-muted">Notación geométrica</span>
      </div>

      <div class="p-4 rounded-xl bg-white border border-hairline flex items-center justify-center">
        <span class="font-mono text-xl sm:text-2xl font-bold text-primary tracking-wide">
          {tool.formulaHtml}
        </span>
      </div>

      <p class="text-xs text-ink-muted leading-relaxed">
        {tool.formulaNote}
      </p>
    </section>

    <!-- Practical Examples & Applications -->
    <section class="space-y-4">
      <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
        Ejemplos prácticos y aplicaciones
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {tool.practicalExamples.map((ex) => (
          <div class="p-4 rounded-xl bg-white border border-hairline shadow-xs flex flex-col gap-1.5">
            <h3 class="text-xs sm:text-sm font-bold text-ink">
              {ex.title}
            </h3>
            <p class="text-xs text-ink-muted leading-relaxed" set:html={ex.desc} />
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ Accordion Section -->
    <section class="space-y-4 pt-4 border-t border-hairline">
      <div class="space-y-1">
        <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
          Preguntas frecuentes
        </h2>
        <p class="text-xs sm:text-sm text-ink-muted">
          Respuestas a dudas habituales sobre medidas, fórmulas y conversión de unidades.
        </p>
      </div>

      <div class="space-y-3">
        {tool.faqs.map((faq) => (
          <details class="group p-4 rounded-xl bg-white border border-hairline shadow-xs transition-colors hover:border-ink-muted cursor-pointer">
            <summary class="text-xs sm:text-sm font-bold text-ink flex items-center justify-between list-none">
              <span>{faq.question}</span>
              <span class="text-ink-muted group-open:rotate-180 transition-transform font-mono text-xs ml-2">
                ▼
              </span>
            </summary>
            <div class="text-xs sm:text-sm text-ink-secondary leading-relaxed pt-2.5 mt-2 border-t border-hairline/60">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Related Calculators Hub Links -->
    <section class="space-y-4 pt-6 border-t border-hairline">
      <div class="flex items-center justify-between">
        <h2 class="text-base sm:text-lg font-bold text-ink tracking-tight">
          Calculadoras de volumen relacionadas
        </h2>
        <a href="/es/calculadoras" class="text-xs font-semibold text-primary hover:underline flex items-center gap-1">
          <span>Ver las 16 calculadoras</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        {relatedTools.map((rel) => {
          const relShape = SHAPES[rel.shapeId];
          return (
            <a
              href={`/es/${rel.slug}`}
              class="p-3.5 rounded-xl bg-white border border-hairline hover:border-primary/40 hover:shadow-xs transition-all flex items-center gap-3 group"
            >
              <span class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                <Fragment set:html={relShape.iconSvg} />
              </span>
              <div class="min-w-0">
                <span class="block text-xs font-bold text-ink truncate group-hover:text-primary transition-colors">
                  {rel.shapeName}
                </span>
                <span class="block text-[11px] text-ink-muted truncate">
                  {rel.formulaHtml}
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { SingleToolCalculatorApp } from '../scripts/single-tool-calculator';

  document.addEventListener('DOMContentLoaded', () => {
    const cardEl = document.getElementById('single-tool-card');
    if (cardEl) {
      new SingleToolCalculatorApp(cardEl);
    }
  });
</script>
