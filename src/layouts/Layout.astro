---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  canonical?: string;
  schemaGraph?: any[];
}

const {
  title = 'Volume Calculator - Calculate Volume in Gallons, Litres & Cu Ft',
  description = 'Free online volume calculator to easily calculate volume for 16 3D shapes. Convert instant liquid & water volume in gallons, litres, cu ft, and m³ with step-by-step formulas.',
  keywords = 'volume calculator, calculate volume, volume calculator gallons, cu ft calculator, water volume calculator, 3d volume calculator, cylinder volume, sphere volume, tank volume calculator, box volume, cubic feet calculator',
  ogType = 'website',
  ogImage = '/og-image.png',
  ogImageAlt = 'The Volume Calculator - Instant 3D Volume & Tank Capacity',
  canonical,
  schemaGraph,
} = Astro.props;

const canonicalUrl = canonical || new URL(Astro.url.pathname, 'https://thevolumecalculator.com').href;
const ogImageUrl = new URL(ogImage, 'https://thevolumecalculator.com').href;

const defaultGraph = [
  {
    '@type': 'WebSite',
    'name': 'The Volume Calculator',
    'url': 'https://thevolumecalculator.com/',
    'potentialAction': {
      '@type': 'SearchAction',
      'target': 'https://thevolumecalculator.com/calculators?q={search_term_string}',
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@type': 'SoftwareApplication',
    'name': 'The Volume Calculator',
    'applicationCategory': 'EducationalApplication',
    'operatingSystem': 'Any',
    'offers': {
      '@type': 'Offer',
      'price': '0',
      'priceCurrency': 'USD',
    },
    'description': description,
    'url': canonicalUrl,
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': schemaGraph && schemaGraph.length > 0 ? schemaGraph : defaultGraph,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Robots: Allow full indexing on main domain, block *.pages.dev -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" id="meta-robots" />
    <script is:inline>
      if (typeof window !== 'undefined' && window.location.hostname.endsWith('.pages.dev')) {
        const meta = document.getElementById('meta-robots');
        if (meta) {
          meta.content = 'noindex, nofollow, noarchive';
        }
      }
    </script>

    <!-- Dark Mode Initializer (Zero Flash of Unstyled Content) -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (_) {}
      })();
    </script>

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="The Volume Calculator" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="The Volume Calculator" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Structured Data (Schema.org JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-canvas-soft text-ink min-h-screen flex flex-col selection:bg-primary/20 selection:text-primary">
    <slot />
  </body>
</html>
