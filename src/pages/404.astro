---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Page not found (404)';
const description = 'The requested geometric calculator or documentation page was not found on thevolumecalculator.com. Browse our 16 free 3D volume calculators.';
const canonical = 'https://thevolumecalculator.com/404';

const popularCalculators = [
  {
    name: 'Cylinder volume calculator',
    href: '/cylinder-volume-calculator',
    desc: 'Volume of regular and circular cylinders (V = π · r² · h).',
  },
  {
    name: 'Box and rectangular prism',
    href: '/box-volume-calculator',
    desc: 'Volume and shipping box capacity (V = l · w · h).',
  },
  {
    name: 'Horizontal tank fill depth',
    href: '/horizontal-tank-volume-calculator',
    desc: 'Cylindrical tank dipstick and partial liquid volume.',
  },
  {
    name: 'Sphere volume calculator',
    href: '/sphere-volume-calculator',
    desc: 'Spherical volume from radius or diameter (V = ⁴⁄₃ · π · r³).',
  },
  {
    name: 'Pool volume calculator',
    href: '/pool-volume-calculator',
    desc: 'Rectangular, round, and oval swimming pool water capacity.',
  },
  {
    name: 'Cubic feet calculator',
    href: '/cubic-feet-calculator',
    desc: 'Convert length, width, and height directly to cubic feet and yards.',
  },
];
---

<Layout
  title={`${title} | thevolumecalculator.com`}
  description={description}
  canonical={canonical}
  robots="noindex, follow"
>
  <Header />

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8 sm:space-y-10">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-1.5 text-xs text-ink-muted">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span>/</span>
      <span class="text-ink font-semibold">404</span>
    </nav>

    <!-- Error Banner & Lead -->
    <section class="space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-white dark:bg-canvas-card border border-hairline text-accent-orange-deep shadow-xs">
        <span class="w-2 h-2 rounded-full bg-accent-orange"></span>
        <span>HTTP status: 404</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-ink tracking-tight leading-tight">
        Page not found
      </h1>

      <p class="text-sm sm:text-base text-ink-secondary leading-relaxed">
        The requested web address does not exist. You may have entered an outdated URL, followed an obsolete external link from an engineering forum, or requested a calculator slug that changed during our site restructuring. Our directory contains 16 verified 3D volume calculators covering regular prisms, industrial tanks, and piping. You can explore the directory or return to the homepage. If you arrived here through a broken link on `thevolumecalculator.com`, please notify our team at <a href="mailto:contact@thevolumecalculator.com" class="text-primary font-semibold hover:underline">contact@thevolumecalculator.com</a> so our engineers can correct the referral path. We audit dead links weekly.
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-primary text-white text-xs sm:text-sm font-semibold hover:bg-primary-active transition-colors shadow-xs"
        >
          <span>Return to homepage</span>
        </a>
        <a
          href="/calculators"
          class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-white dark:bg-[#1e1e1e] border border-hairline text-ink text-xs sm:text-sm font-semibold hover:border-primary transition-colors shadow-xs"
        >
          <span>Browse all 16 calculators</span>
        </a>
      </div>
    </section>

    <!-- Recommended Calculators Grid -->
    <section class="bg-white dark:bg-canvas-card rounded-2xl border border-hairline p-5 sm:p-7 shadow-xs space-y-5">
      <div class="space-y-1">
        <h2 class="text-lg sm:text-xl font-bold text-ink tracking-tight">
          Recommended 3D volume calculators
        </h2>
        <p class="text-xs sm:text-sm text-ink-secondary leading-relaxed">
          Six high-traffic calculators appear below. Each calculation tool provides step-by-step Euclidean formula derivations, interactive geometric diagrams, and instant multi-unit conversion between US gallons, UK gallons, liters, cubic feet, and cubic meters. The complete catalog of 16 tools remains accessible on our <a href="/calculators" class="text-primary font-semibold hover:underline">calculators</a> index page. Engineers requiring formal documentation of physical conversion constants can consult our dedicated <a href="/methodology" class="text-primary font-semibold hover:underline">methodology</a> guide at any time. All tools remain completely free. Our computing platform operates with zero registration requirements, zero paywalls, and zero advertising cookies across all 206 static documentation pages in 11 international language editions.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 pt-2">
        {popularCalculators.map((calc) => (
          <a
            href={calc.href}
            class="block p-4 rounded-xl border border-hairline bg-surface hover:border-primary hover:shadow-xs transition-all group"
          >
            <h3 class="text-sm font-bold text-ink group-hover:text-primary transition-colors">
              {calc.name}
            </h3>
            <p class="text-xs text-ink-muted mt-1 leading-relaxed">
              {calc.desc}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Help & Assistance Section -->
    <section class="bg-white dark:bg-canvas-card rounded-2xl border border-hairline p-5 sm:p-7 shadow-xs space-y-3">
      <h2 class="text-base sm:text-lg font-bold text-ink tracking-tight">
        Assistance and broken link reporting
      </h2>
      <p class="text-xs sm:text-sm text-ink-secondary leading-relaxed">
        If you require a specialized geometric equation that does not appear in our directory, visit our <a href="/contact-us" class="text-primary font-semibold hover:underline">contact us</a> page or message <a href="https://x.com/devxkamlesh" target="_blank" rel="noopener noreferrer" class="text-primary font-semibold hover:underline">@devxkamlesh</a> on X. Inquiries receive attention within 48 business hours from our Jaipur office.
      </p>
    </section>
  </main>

  <Footer />
</Layout>
