---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'About us';
const description = 'Learn about thevolumecalculator.com, our client-side geometric computing architecture, mathematical verification standards, and engineering team.';
const canonical = 'https://thevolumecalculator.com/about-us';

const alternates = [
  { hreflang: 'en', href: canonical },
  { hreflang: 'x-default', href: canonical },
];

const schemaGraph = [
  {
    '@type': 'AboutPage',
    'name': 'About us | thevolumecalculator.com',
    'description': description,
    'url': canonical,
    'publisher': {
      '@type': 'Organization',
      'name': 'The Volume Calculator',
      'url': 'https://thevolumecalculator.com',
      'logo': 'https://thevolumecalculator.com/favicon-48x48.png',
    },
  },
  {
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'Home',
        'item': 'https://thevolumecalculator.com/',
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': 'About us',
        'item': canonical,
      },
    ],
  },
];
---

<Layout
  title={`${title} | thevolumecalculator.com`}
  description={description}
  canonical={canonical}
  alternates={alternates}
  schemaGraph={schemaGraph}
>
  <Header />

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8 sm:space-y-12">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-1.5 text-xs text-ink-muted">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span>/</span>
      <span class="text-ink font-semibold">About us</span>
    </nav>

    <!-- Page Header -->
    <section class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-white dark:bg-canvas-card border border-hairline text-primary shadow-xs">
        <span class="w-2 h-2 rounded-full bg-accent-green"></span>
        <span>Platform & Engineering Background</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-ink tracking-tight leading-tight">
        About us
      </h1>

      <p class="text-sm sm:text-base text-ink-secondary leading-relaxed">
        Kamlesh Choudhary founded thevolumecalculator.com in January 2025 in Jaipur, India, to provide engineers, contractors, and students with immediate geometric calculations without paywalls or registrations. The platform contains 16 specialized 3D calculators covering basic prisms, curved shapes, and industrial storage tanks. Calculations run client-side. Standard web calculators send dimensional measurements across network sockets to distant database servers, which introduces network latency and risks data leakage during transit. The computing model here retains 100 percent of your dimensional numbers inside local device memory. The browser cleans all values upon closing the active session tab.
      </p>
    </section>

    <!-- Section 1: Precision Standards -->
    <section class="bg-white dark:bg-canvas-card rounded-2xl border border-hairline p-5 sm:p-7 shadow-xs space-y-4">
      <h2 class="text-lg sm:text-xl font-bold text-ink tracking-tight">
        Mathematical standards and precision
      </h2>
      <p class="text-xs sm:text-sm text-ink-secondary leading-relaxed">
        All conversion factors follow the physical definitions established by the National Institute of Standards and Technology in publication SP 811 and ISO standard 80000-3 for spatial measurements. Calculations use 64-bit IEEE 754 floating point arithmetic. Pi equals 3.141592653589793. The test suite contains 20 automated unit tests in `src/scripts/core.test.ts` to verify numerical limits and prevents rounding drifts across 11 metric and imperial units. The system rounds displayed answers to 4 decimal places by default, while retaining full 15-digit precision for subsequent unit conversions. Users can copy derivations directly into laboratory notebooks or job site logs.
      </p>
    </section>

    <!-- Section 2: Global Infrastructure -->
    <section class="bg-white dark:bg-canvas-card rounded-2xl border border-hairline p-5 sm:p-7 shadow-xs space-y-4">
      <h2 class="text-lg sm:text-xl font-bold text-ink tracking-tight">
        Global reach and international access
      </h2>
      <p class="text-xs sm:text-sm text-ink-secondary leading-relaxed">
        Global access is central to the project. The site hosts localized interfaces for 11 languages: English, Spanish, Portuguese, German, French, Russian, Japanese, Chinese, Italian, Arabic, and Hindi. Engineers and native speakers verified the technical terminology for each language, providing custom right-to-left layout mechanics for Arabic readers. Each locale contains identical formula proofs and interactive tools across all 206 static pages. The static architecture deploys directly across more than 300 data center locations through the Cloudflare network, delivering pages to visitors from the closest server cache. First contentful paint occurs within 350 milliseconds on standard 4G connections.
      </p>
    </section>

    <!-- Section 3: Engineering and Contact -->
    <section class="bg-white dark:bg-canvas-card rounded-2xl border border-hairline p-5 sm:p-7 shadow-xs space-y-4">
      <h2 class="text-lg sm:text-xl font-bold text-ink tracking-tight">
        Engineering leadership
      </h2>
      <p class="text-xs sm:text-sm text-ink-secondary leading-relaxed">
        Kamlesh Choudhary oversees software architecture and mathematical auditing for the platform. He maintains the open code repository on GitHub and publishes technical updates on X at <a href="https://x.com/devxkamlesh" target="_blank" rel="noopener noreferrer" class="text-primary font-semibold hover:underline">@devxkamlesh</a>. Direct inquiries reach him via email at <a href="mailto:contact@thevolumecalculator.com" class="text-primary font-semibold hover:underline">contact@thevolumecalculator.com</a>. Users who detect edge case anomalies in complex geometries can submit bug reports directly through the repository tracker.
      </p>
    </section>
  </main>

  <Footer />
</Layout>
