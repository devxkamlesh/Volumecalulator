---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ICONS } from '../scripts/icons';

const title = 'Cubic Feet Calculator (Cu Ft) - Convert Cu Ft to Cu Yd';
const description = 'Free online cubic feet calculator (cu ft). Calculate volume in cubic feet and cubic yards from inches, feet, or meters. Instant material estimator for soil, mulch, concrete, and freight.';
const keywords = 'cu ft calculator, calculate cubic foot, cu ft cu yd, cu ft to cu yd, cubic inches to cubic feet, cubic feet calculator, cubic yard calculator, calculate cu ft, volume in cubic feet';
const canonical = 'https://thevolumecalculator.com/cubic-feet-calculator';

const schemaGraph = [
  {
    '@type': 'SoftwareApplication',
    'name': 'Cubic Feet & Cubic Yards Calculator',
    'applicationCategory': 'EducationalApplication',
    'operatingSystem': 'Any',
    'description': description,
    'url': canonical,
    'offers': {
      '@type': 'Offer',
      'price': '0',
      'priceCurrency': 'USD'
    }
  },
  {
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'Home',
        'item': 'https://thevolumecalculator.com/'
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': 'Calculators',
        'item': 'https://thevolumecalculator.com/calculators'
      },
      {
        '@type': 'ListItem',
        'position': 3,
        'name': 'Cubic Feet Calculator',
        'item': canonical
      }
    ]
  },
  {
    '@type': 'FAQPage',
    'mainEntity': [
      {
        '@type': 'Question',
        'name': 'How do you calculate cubic feet?',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'To calculate cubic feet, multiply Length (ft) × Width (ft) × Depth/Height (ft). If your measurements are in inches, multiply Length (in) × Width (in) × Height (in) and divide the total by 1,728.'
        }
      },
      {
        '@type': 'Question',
        'name': 'How do you convert cubic feet to cubic yards (cu ft to cu yd)?',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'Divide the total cubic feet by 27: Cubic Yards = Cubic Feet / 27. For example, 54 cubic feet equals 2 cubic yards.'
        }
      },
      {
        '@type': 'Question',
        'name': 'How many cubic inches are in a cubic foot?',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'There are exactly 1,728 cubic inches in one cubic foot (12 inches × 12 inches × 12 inches = 1,728 in³).'
        }
      },
      {
        '@type': 'Question',
        'name': 'How many cubic feet of mulch or soil do I need?',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'Multiply your garden bed length in feet by width in feet, then multiply by desired depth in inches, and divide by 12. For example, a 10 ft × 12 ft garden bed with 3 inches of mulch requires (10 × 12 × 3) / 12 = 30 cubic feet (or 1.11 cubic yards).'
        }
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  schemaGraph={schemaGraph}
>
  <Header />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8 sm:space-y-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-ink-muted font-medium" aria-label="Breadcrumb">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span>/</span>
      <a href="/calculators" class="hover:text-primary transition-colors">Calculators</a>
      <span>/</span>
      <span class="text-ink font-semibold">Cubic Feet Calculator</span>
    </nav>

    <!-- Hero Header -->
    <section class="space-y-3">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full border bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 border-amber-200 dark:border-amber-800">
          Construction & Landscaping
        </span>
        <span class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-canvas-soft border border-hairline text-ink-muted">
          Cu Ft &harr; Cu Yd &harr; In³
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-ink tracking-tight flex items-center gap-3">
        <span class="w-9 h-9 sm:w-11 sm:h-11 rounded-xl bg-primary/10 border border-primary/20 text-primary flex items-center justify-center shrink-0">
          <Fragment set:html={ICONS.truck} />
        </span>
        <span>Cubic Feet Calculator (Cu Ft)</span>
      </h1>

      <p class="text-sm sm:text-base text-ink-secondary max-w-3xl leading-relaxed">
        Calculate volume in cubic feet (ft³) and convert directly to cubic yards (yd³) or cubic inches (in³). Supports mixed units (e.g. feet length with inches depth) for concrete slabs, mulch beds, soil, and freight packing.
      </p>
    </section>

    <!-- Interactive Calculator Card -->
    <div
      id="cuft-calculator-card"
      class="bg-white rounded-2xl border border-hairline p-5 sm:p-7 shadow-xs space-y-6"
    >
      <!-- Top Control Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-hairline">
        <!-- Mode Tabs -->
        <div class="flex items-center gap-1.5 p-1 rounded-xl bg-canvas-soft border border-hairline overflow-x-auto" role="tablist">
          <button
            type="button"
            data-mode="box"
            class="cuft-tab px-3 py-1.5 rounded-lg text-xs font-semibold transition-all bg-white shadow-xs text-primary border border-hairline/80"
            role="tab"
            aria-selected="true"
          >
            Rectangular (L × W × H)
          </button>
          <button
            type="button"
            data-mode="cylinder"
            class="cuft-tab px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-ink-muted hover:text-ink"
            role="tab"
            aria-selected="false"
          >
            Circular Column / Hole
          </button>
          <button
            type="button"
            data-mode="direct"
            class="cuft-tab px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-ink-muted hover:text-ink"
            role="tab"
            aria-selected="false"
          >
            Quick Unit Converter
          </button>
        </div>

        <button
          type="button"
          id="cuft-clear-btn"
          class="text-xs font-semibold px-3 py-1.5 rounded-md bg-canvas-soft border border-hairline text-ink-muted hover:text-ink hover:border-ink-muted transition-colors cursor-pointer self-start sm:self-auto"
        >
          Clear All
        </button>
      </div>

      <!-- Main Form & Diagram Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-center">
        <!-- Form Inputs Column (7 cols) -->
        <div class="lg:col-span-7 flex flex-col gap-4">
          <!-- 1. Box / Trench Mode Inputs -->
          <div id="section-box-inputs" class="flex flex-col gap-3.5">
            <!-- Length -->
            <div class="flex flex-col gap-1.5">
              <label for="cuft-in-len" class="text-xs sm:text-sm font-bold text-ink flex items-center justify-between">
                <span>Length</span>
                <span class="text-[11px] font-normal text-ink-faint">Span</span>
              </label>
              <div class="flex items-center gap-2">
                <input
                  type="number"
                  id="cuft-in-len"
                  step="any"
                  min="0"
                  placeholder="e.g. 10"
                  class="w-full text-base font-semibold px-3.5 py-2.5 rounded-xl border border-hairline bg-surface text-ink focus:outline-hidden focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                />
                <select
                  id="cuft-unit-len"
                  class="text-xs font-semibold px-3 py-2.5 rounded-xl border border-hairline bg-canvas-soft text-ink shrink-0 cursor-pointer"
                >
                  <option value="ft" selected>Feet (ft)</option>
                  <option value="in">Inches (in)</option>
                  <option value="yd">Yards (yd)</option>
                  <option value="m">Meters (m)</option>
                </select>
              </div>
            </div>

            <!-- Width -->
            <div class="flex flex-col gap-1.5">
              <label for="cuft-in-width" class="text-xs sm:text-sm font-bold text-ink flex items-center justify-between">
                <span>Width</span>
                <span class="text-[11px] font-normal text-ink-faint">Across</span>
              </label>
              <div class="flex items-center gap-2">
                <input
                  type="number"
                  id="cuft-in-width"
                  step="any"
                  min="0"
                  placeholder="e.g. 8"
                  class="w-full text-base font-semibold px-3.5 py-2.5 rounded-xl border border-hairline bg-surface text-ink focus:outline-hidden focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                />
                <select
                  id="cuft-unit-width"
                  class="text-xs font-semibold px-3 py-2.5 rounded-xl border border-hairline bg-canvas-soft text-ink shrink-0 cursor-pointer"
                >
                  <option value="ft" selected>Feet (ft)</option>
                  <option value="in">Inches (in)</option>
                  <option value="yd">Yards (yd)</option>
                  <option value="m">Meters (m)</option>
                </select>
              </div>
            </div>

            <!-- Depth / Height (Defaults to Inches for Landscaping & Slabs) -->
            <div class="flex flex-col gap-1.5">
              <label for="cuft-in-depth" class="text-xs sm:text-sm font-bold text-ink flex items-center justify-between">
                <span>Depth / Height / Thickness</span>
                <span class="text-[11px] font-normal text-ink-faint">Thickness</span>
              </label>
              <div class="flex items-center gap-2">
                <input
                  type="number"
                  id="cuft-in-depth"
                  step="any"
                  min="0"
                  placeholder="e.g. 4"
                  class="w-full text-base font-semibold px-3.5 py-2.5 rounded-xl border border-hairline bg-surface text-ink focus:outline-hidden focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                />
                <select
                  id="cuft-unit-depth"
                  class="text-xs font-semibold px-3 py-2.5 rounded-xl border border-hairline bg-canvas-soft text-ink shrink-0 cursor-pointer"
                >
                  <option value="in" selected>Inches (in)</option>
                  <option value="ft">Feet (ft)</option>
                  <option value="yd">Yards (yd)</option>
                  <option value="cm">Centimeters (cm)</option>
                </select>
              </div>
            </div>
          </div>

          <!-- 2. Cylinder / Round Mode Inputs -->
          <div id="section-cyl-inputs" class="flex flex-col gap-3.5 hidden">
            <div class="flex flex-col gap-1.5">
              <label for="cuft-in-dia" class="text-xs sm:text-sm font-bold text-ink flex items-center justify-between">
                <span>Diameter (Across circle)</span>
                <span class="text-[11px] font-normal text-ink-faint">Full width</span>
              </label>
              <div class="flex items-center gap-2">
                <input
                  type="number"
                  id="cuft-in-dia"
                  step="any"
                  min="0"
                  placeholder="e.g. 3"
                  class="w-full text-base font-semibold px-3.5 py-2.5 rounded-xl border border-hairline bg-surface text-ink focus:outline-hidden focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                />
                <select id="cuft-unit-dia" class="text-xs font-semibold px-3 py-2.5 rounded-xl border border-hairline bg-canvas-soft text-ink shrink-0 cursor-pointer">
                  <option value="ft" selected>Feet (ft)</option>
                  <option value="in">Inches (in)</option>
                </select>
              </div>
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="cuft-in-cyl-depth" class="text-xs sm:text-sm font-bold text-ink flex items-center justify-between">
                <span>Depth / Height</span>
                <span class="text-[11px] font-normal text-ink-faint">Depth</span>
              </label>
              <div class="flex items-center gap-2">
                <input
                  type="number"
                  id="cuft-in-cyl-depth"
                  step="any"
                  min="0"
                  placeholder="e.g. 4"
                  class="w-full text-base font-semibold px-3.5 py-2.5 rounded-xl border border-hairline bg-surface text-ink focus:outline-hidden focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                />
                <select id="cuft-unit-cyl-depth" class="text-xs font-semibold px-3 py-2.5 rounded-xl border border-hairline bg-canvas-soft text-ink shrink-0 cursor-pointer">
                  <option value="ft" selected>Feet (ft)</option>
                  <option value="in">Inches (in)</option>
                </select>
              </div>
            </div>
          </div>

          <!-- 3. Direct Unit Converter Mode -->
          <div id="section-direct-inputs" class="flex flex-col gap-3.5 hidden">
            <div class="flex flex-col gap-1.5">
              <label for="cuft-in-direct" class="text-xs sm:text-sm font-bold text-ink">
                Enter Known Volume
              </label>
              <div class="flex items-center gap-2">
                <input
                  type="number"
                  id="cuft-in-direct"
                  step="any"
                  min="0"
                  placeholder="e.g. 54"
                  class="w-full text-base font-semibold px-3.5 py-2.5 rounded-xl border border-hairline bg-surface text-ink focus:outline-hidden focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                />
                <select id="cuft-unit-direct" class="text-xs font-semibold px-3 py-2.5 rounded-xl border border-hairline bg-canvas-soft text-ink shrink-0 cursor-pointer">
                  <option value="ft3" selected>Cubic Feet (ft³)</option>
                  <option value="yd3">Cubic Yards (yd³)</option>
                  <option value="in3">Cubic Inches (in³)</option>
                  <option value="gal">US Gallons (gal)</option>
                  <option value="m3">Cubic Meters (m³)</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <!-- Diagram & Visual Dimension Box (5 cols) -->
        <div class="lg:col-span-5 bg-canvas-soft rounded-2xl border border-hairline p-5 flex flex-col items-center justify-center min-h-[220px]">
          <div class="w-full max-w-[260px] text-primary flex items-center justify-center">
            <svg viewBox="0 0 240 180" class="w-full h-auto drop-shadow-sm" fill="none" stroke="currentColor">
              <!-- 3D Isometric Cube / Prism -->
              <polygon points="120,20 200,60 120,100 40,60" fill="rgba(14, 165, 233, 0.08)" stroke="#0284c7" stroke-width="2" />
              <polygon points="40,60 120,100 120,160 40,120" fill="rgba(14, 165, 233, 0.16)" stroke="#0284c7" stroke-width="2" />
              <polygon points="120,100 200,60 200,120 120,160" fill="rgba(14, 165, 233, 0.24)" stroke="#0284c7" stroke-width="2" />
              <!-- Dimension Callout lines -->
              <text x="75" y="40" fill="#0369a1" font-size="10" font-weight="bold">Length</text>
              <text x="165" y="40" fill="#0369a1" font-size="10" font-weight="bold">Width</text>
              <text x="210" y="95" fill="#0369a1" font-size="10" font-weight="bold">Height</text>
              <!-- Center 1 Cu Yd Badge -->
              <text x="120" y="175" fill="#64748b" font-size="10" text-anchor="middle" font-weight="bold">1 Cubic Yard = 27 Cubic Feet</text>
            </svg>
          </div>
          <span class="text-[11px] font-medium text-ink-muted mt-2 text-center">
            Standard 3D volumetric cubic displacement
          </span>
        </div>
      </div>

      <!-- Results Grid -->
      <div class="pt-4 border-t border-hairline space-y-4">
        <!-- Double Highlight Card: Cu Ft + Cu Yd -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <!-- Card 1: Cubic Feet -->
          <div class="p-4 rounded-xl bg-sky-50 dark:bg-sky-950/30 border border-sky-200 dark:border-sky-800 flex items-center justify-between">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-sky-700 dark:text-sky-300">Total Volume</span>
              <div class="flex items-baseline gap-1.5 mt-0.5">
                <span id="res-cuft" class="text-2xl sm:text-3xl font-extrabold text-sky-900 dark:text-sky-100">—</span>
                <span class="text-sm font-bold text-sky-700 dark:text-sky-300">ft³ (cu ft)</span>
              </div>
            </div>
            <button
              type="button"
              id="btn-copy-cuft"
              class="text-xs font-bold px-3 py-1.5 rounded-lg bg-sky-600 hover:bg-sky-700 text-white transition-colors cursor-pointer"
            >
              Copy
            </button>
          </div>

          <!-- Card 2: Cubic Yards -->
          <div class="p-4 rounded-xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800 flex items-center justify-between">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-amber-700 dark:text-amber-300">Cubic Yards (yd³)</span>
              <div class="flex items-baseline gap-1.5 mt-0.5">
                <span id="res-cuyd" class="text-2xl sm:text-3xl font-extrabold text-amber-900 dark:text-amber-100">—</span>
                <span class="text-sm font-bold text-amber-700 dark:text-amber-300">yd³ (cu yd)</span>
              </div>
            </div>
            <button
              type="button"
              id="btn-copy-cuyd"
              class="text-xs font-bold px-3 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-700 text-white transition-colors cursor-pointer"
            >
              Copy
            </button>
          </div>
        </div>

        <!-- Equivalent Multi-Units Matrix -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs">
          <div class="p-3 rounded-xl bg-canvas-soft border border-hairline space-y-1">
            <span class="text-ink-muted text-[11px] font-sans font-medium block">Cubic Inches (in³)</span>
            <span id="res-cuin" class="text-sm font-bold text-ink block">—</span>
          </div>
          <div class="p-3 rounded-xl bg-canvas-soft border border-hairline space-y-1">
            <span class="text-ink-muted text-[11px] font-sans font-medium block">US Gallons (gal)</span>
            <span id="res-gallons" class="text-sm font-bold text-ink block">—</span>
          </div>
          <div class="p-3 rounded-xl bg-canvas-soft border border-hairline space-y-1">
            <span class="text-ink-muted text-[11px] font-sans font-medium block">Cubic Meters (m³)</span>
            <span id="res-m3" class="text-sm font-bold text-ink block">—</span>
          </div>
          <div class="p-3 rounded-xl bg-canvas-soft border border-hairline space-y-1">
            <span class="text-ink-muted text-[11px] font-sans font-medium block">Liters (L)</span>
            <span id="res-liters" class="text-sm font-bold text-ink block">—</span>
          </div>
        </div>

        <!-- Live Step Math Derivation Box -->
        <div id="cuft-math-box" class="p-3.5 rounded-xl bg-canvas-soft border border-hairline text-xs font-mono space-y-1">
          <span class="text-ink-muted font-sans font-bold text-[11px] uppercase tracking-wider block">
            Calculation Derivation:
          </span>
          <p id="cuft-math-formula" class="text-ink leading-relaxed">
            Enter your length, width, and depth above to view step-by-step arithmetic.
          </p>
        </div>
      </div>
    </div>

    <!-- SEO Content Section: Formulas, Conversion Table & Bulk Material Estimates -->
    <article class="space-y-8 text-ink text-sm sm:text-base leading-relaxed">
      <!-- How to calculate cubic feet -->
      <section class="space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-ink">
          How to Calculate Cubic Feet (Formulas & Equations)
        </h2>
        <p class="text-ink-secondary">
          A cubic foot (ft³) is a unit of volume measuring one foot long by one foot wide by one foot deep. To calculate the volume of any rectangular 3-dimensional space:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-mono text-xs">
          <div class="p-4 rounded-xl border border-hairline bg-white space-y-2">
            <span class="font-sans font-bold text-sm text-ink block">When dimensions are in Feet:</span>
            <p class="text-primary font-bold">Cubic Feet = Length (ft) × Width (ft) × Height (ft)</p>
            <p class="text-ink-muted font-sans text-xs">Example: 10 ft × 8 ft × 2 ft = 160 ft³.</p>
          </div>
          <div class="p-4 rounded-xl border border-hairline bg-white space-y-2">
            <span class="font-sans font-bold text-sm text-ink block">When dimensions are in Inches:</span>
            <p class="text-primary font-bold">Cubic Feet = (Length × Width × Height in inches) ÷ 1,728</p>
            <p class="text-ink-muted font-sans text-xs">Since 1 ft³ = 12 × 12 × 12 = 1,728 in³.</p>
          </div>
        </div>
      </section>

      <!-- Cu Ft to Cu Yd Conversion Chart -->
      <section class="space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-ink">
          Cubic Feet to Cubic Yards (Cu Ft to Cu Yd) Conversion Table
        </h2>
        <p class="text-ink-secondary">
          In landscaping, concrete, and soil orders, materials are sold in <strong>cubic yards</strong>. Since 1 yard equals 3 feet, 1 cubic yard equals 3 × 3 × 3 = <strong>27 cubic feet</strong>.
        </p>

        <div class="overflow-x-auto rounded-xl border border-hairline">
          <table class="w-full text-left text-xs sm:text-sm border-collapse">
            <thead class="bg-canvas-soft border-b border-hairline font-bold text-ink">
              <tr>
                <th class="p-3 sm:p-3.5">Cubic Feet (ft³)</th>
                <th class="p-3 sm:p-3.5">Cubic Yards (yd³)</th>
                <th class="p-3 sm:p-3.5">Liquid Gallons (gal)</th>
                <th class="p-3 sm:p-3.5">Cubic Meters (m³)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline font-mono text-xs">
              <tr>
                <td class="p-3 font-bold text-primary">27 ft³</td>
                <td class="p-3 font-bold text-ink">1.00 cu yd</td>
                <td class="p-3 text-ink-muted">202.0 gal</td>
                <td class="p-3 text-ink-muted">0.765 m³</td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-primary">54 ft³</td>
                <td class="p-3 font-bold text-ink">2.00 cu yd</td>
                <td class="p-3 text-ink-muted">403.9 gal</td>
                <td class="p-3 text-ink-muted">1.529 m³</td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-primary">81 ft³</td>
                <td class="p-3 font-bold text-ink">3.00 cu yd</td>
                <td class="p-3 text-ink-muted">605.9 gal</td>
                <td class="p-3 text-ink-muted">2.294 m³</td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-primary">135 ft³</td>
                <td class="p-3 font-bold text-ink">5.00 cu yd</td>
                <td class="p-3 text-ink-muted">1,009.9 gal</td>
                <td class="p-3 text-ink-muted">3.823 m³</td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-primary">270 ft³</td>
                <td class="p-3 font-bold text-ink">10.00 cu yd</td>
                <td class="p-3 text-ink-muted">2,019.7 gal</td>
                <td class="p-3 text-ink-muted">7.646 m³</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- FAQs -->
      <section class="space-y-4 pt-4 border-t border-hairline">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-ink">
          Frequently Asked Questions
        </h2>

        <div class="space-y-3">
          <details class="group rounded-xl border border-hairline p-4 transition-colors open:bg-canvas-soft/30">
            <summary class="font-semibold text-xs sm:text-sm text-ink cursor-pointer list-none flex items-center justify-between gap-2">
              <span>How do I convert inches to cubic feet?</span>
              <span class="text-ink-muted transition-transform group-open:rotate-180 text-xs">▼</span>
            </summary>
            <p class="mt-2.5 pt-2.5 border-t border-hairline text-xs text-ink-secondary leading-relaxed">
              Multiply length (in) × width (in) × height (in) to get total cubic inches, then divide by 1,728. For example: 24 in × 18 in × 12 in = 5,184 in³. Then 5,184 ÷ 1,728 = <strong>3 cubic feet</strong>.
            </p>
          </details>

          <details class="group rounded-xl border border-hairline p-4 transition-colors open:bg-canvas-soft/30">
            <summary class="font-semibold text-xs sm:text-sm text-ink cursor-pointer list-none flex items-center justify-between gap-2">
              <span>How do I calculate concrete volume for a slab?</span>
              <span class="text-ink-muted transition-transform group-open:rotate-180 text-xs">▼</span>
            </summary>
            <p class="mt-2.5 pt-2.5 border-t border-hairline text-xs text-ink-secondary leading-relaxed">
              Convert the slab thickness from inches into feet (e.g. 4 inches = 4/12 = 0.333 ft). Multiply length (ft) × width (ft) × thickness (ft) to get cubic feet, then divide by 27 to get the cubic yards of ready-mix concrete to order.
            </p>
          </details>

          <details class="group rounded-xl border border-hairline p-4 transition-colors open:bg-canvas-soft/30">
            <summary class="font-semibold text-xs sm:text-sm text-ink cursor-pointer list-none flex items-center justify-between gap-2">
              <span>How many cubic feet are in a cubic yard?</span>
              <span class="text-ink-muted transition-transform group-open:rotate-180 text-xs">▼</span>
            </summary>
            <p class="mt-2.5 pt-2.5 border-t border-hairline text-xs text-ink-secondary leading-relaxed">
              There are exactly <strong>27 cubic feet</strong> in one cubic yard (3 ft × 3 ft × 3 ft = 27 ft³).
            </p>
          </details>
        </div>
      </section>
    </article>
  </main>

  <Footer />

  <!-- Client-side Script -->
  <script>
    function initCuFtCalculator() {
      let activeMode = 'box';

      const tabs = document.querySelectorAll('.cuft-tab');
      const secBox = document.getElementById('section-box-inputs');
      const secCyl = document.getElementById('section-cyl-inputs');
      const secDirect = document.getElementById('section-direct-inputs');

      const inLen = document.getElementById('cuft-in-len');
      const unitLen = document.getElementById('cuft-unit-len');
      const inWidth = document.getElementById('cuft-in-width');
      const unitWidth = document.getElementById('cuft-unit-width');
      const inDepth = document.getElementById('cuft-in-depth');
      const unitDepth = document.getElementById('cuft-unit-depth');

      const inDia = document.getElementById('cuft-in-dia');
      const unitDia = document.getElementById('cuft-unit-dia');
      const inCylDepth = document.getElementById('cuft-in-cyl-depth');
      const unitCylDepth = document.getElementById('cuft-unit-cyl-depth');

      const inDirect = document.getElementById('cuft-in-direct');
      const unitDirect = document.getElementById('cuft-unit-direct');

      const resCuFt = document.getElementById('res-cuft');
      const resCuYd = document.getElementById('res-cuyd');
      const resCuIn = document.getElementById('res-cuin');
      const resGal = document.getElementById('res-gallons');
      const resM3 = document.getElementById('res-m3');
      const resLiters = document.getElementById('res-liters');
      const mathFormula = document.getElementById('cuft-math-formula');

      const clearBtn = document.getElementById('cuft-clear-btn');
      const copyCuFtBtn = document.getElementById('btn-copy-cuft');
      const copyCuYdBtn = document.getElementById('btn-copy-cuyd');

      function toFeet(val, unit) {
        if (isNaN(val) || val <= 0) return 0;
        if (unit === 'ft') return val;
        if (unit === 'in') return val / 12;
        if (unit === 'yd') return val * 3;
        if (unit === 'm') return val * 3.28084;
        if (unit === 'cm') return val * 0.0328084;
        return val;
      }

      function calculate() {
        let totalCuFt = 0;
        let stepMath = '';

        if (activeMode === 'box') {
          const l = toFeet(parseFloat(inLen?.value || '0'), unitLen?.value || 'ft');
          const w = toFeet(parseFloat(inWidth?.value || '0'), unitWidth?.value || 'ft');
          const d = toFeet(parseFloat(inDepth?.value || '0'), unitDepth?.value || 'in');

          if (l > 0 && w > 0 && d > 0) {
            totalCuFt = l * w * d;
            stepMath = l.toFixed(2) + ' ft × ' + w.toFixed(2) + ' ft × ' + d.toFixed(2) + ' ft = ' + totalCuFt.toFixed(2) + ' ft³';
          }
        } else if (activeMode === 'cylinder') {
          const dia = toFeet(parseFloat(inDia?.value || '0'), unitDia?.value || 'ft');
          const depth = toFeet(parseFloat(inCylDepth?.value || '0'), unitCylDepth?.value || 'ft');

          if (dia > 0 && depth > 0) {
            const r = dia / 2;
            totalCuFt = Math.PI * r * r * depth;
            stepMath = 'π × (' + r.toFixed(2) + ' ft)² × ' + depth.toFixed(2) + ' ft = ' + totalCuFt.toFixed(2) + ' ft³';
          }
        } else if (activeMode === 'direct') {
          const val = parseFloat(inDirect?.value || '0');
          const unit = unitDirect?.value || 'ft3';

          if (val > 0) {
            if (unit === 'ft3') totalCuFt = val;
            else if (unit === 'yd3') totalCuFt = val * 27;
            else if (unit === 'in3') totalCuFt = val / 1728;
            else if (unit === 'gal') totalCuFt = val / 7.48052;
            else if (unit === 'm3') totalCuFt = val * 35.3147;
            stepMath = 'Converted ' + val + ' ' + unit + ' to ' + totalCuFt.toFixed(2) + ' ft³';
          }
        }

        if (totalCuFt > 0) {
          const cuYd = totalCuFt / 27;
          const cuIn = totalCuFt * 1728;
          const gal = totalCuFt * 7.48052;
          const m3 = totalCuFt * 0.0283168;
          const liters = totalCuFt * 28.3168;

          if (resCuFt) resCuFt.textContent = totalCuFt.toLocaleString('en-US', { maximumFractionDigits: 2 });
          if (resCuYd) resCuYd.textContent = cuYd.toLocaleString('en-US', { maximumFractionDigits: 3 });
          if (resCuIn) resCuIn.textContent = Math.round(cuIn).toLocaleString('en-US') + ' in³';
          if (resGal) resGal.textContent = Math.round(gal).toLocaleString('en-US') + ' gal';
          if (resM3) resM3.textContent = m3.toLocaleString('en-US', { maximumFractionDigits: 3 }) + ' m³';
          if (resLiters) resLiters.textContent = Math.round(liters).toLocaleString('en-US') + ' L';

          if (mathFormula) {
            mathFormula.innerHTML = '<span>' + stepMath + '</span><br/><span class="text-primary font-bold">' + totalCuFt.toFixed(2) + ' ft³ ÷ 27 = ' + cuYd.toFixed(3) + ' Cubic Yards (yd³)</span>';
          }
        } else {
          if (resCuFt) resCuFt.textContent = '—';
          if (resCuYd) resCuYd.textContent = '—';
          if (resCuIn) resCuIn.textContent = '—';
          if (resGal) resGal.textContent = '—';
          if (resM3) resM3.textContent = '—';
          if (resLiters) resLiters.textContent = '—';
          if (mathFormula) mathFormula.textContent = 'Enter your length, width, and depth above to view step-by-step arithmetic.';
        }
      }

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          tabs.forEach((t) => {
            t.classList.remove('bg-white', 'shadow-xs', 'text-primary', 'border', 'border-hairline/80');
            t.classList.add('text-ink-muted');
            t.setAttribute('aria-selected', 'false');
          });
          tab.classList.add('bg-white', 'shadow-xs', 'text-primary', 'border', 'border-hairline/80');
          tab.classList.remove('text-ink-muted');
          tab.setAttribute('aria-selected', 'true');

          activeMode = tab.getAttribute('data-mode') || 'box';
          if (activeMode === 'box') {
            secBox?.classList.remove('hidden');
            secCyl?.classList.add('hidden');
            secDirect?.classList.add('hidden');
          } else if (activeMode === 'cylinder') {
            secBox?.classList.add('hidden');
            secCyl?.classList.remove('hidden');
            secDirect?.classList.add('hidden');
          } else if (activeMode === 'direct') {
            secBox?.classList.add('hidden');
            secCyl?.classList.add('hidden');
            secDirect?.classList.remove('hidden');
          }
          calculate();
        });
      });

      [inLen, unitLen, inWidth, unitWidth, inDepth, unitDepth, inDia, unitDia, inCylDepth, unitCylDepth, inDirect, unitDirect].forEach((el) => {
        if (!el) return;
        el.addEventListener('input', calculate);
        el.addEventListener('change', calculate);
      });

      clearBtn?.addEventListener('click', () => {
        [inLen, inWidth, inDepth, inDia, inCylDepth, inDirect].forEach((i) => {
          if (i) i.value = '';
        });
        calculate();
      });

      copyCuFtBtn?.addEventListener('click', () => {
        const text = resCuFt?.textContent || '';
        if (text && text !== '—') {
          navigator.clipboard.writeText(text.replace(/,/g, '') + ' ft³');
          const prev = copyCuFtBtn.textContent;
          copyCuFtBtn.textContent = 'Copied!';
          setTimeout(() => { copyCuFtBtn.textContent = prev; }, 1800);
        }
      });

      copyCuYdBtn?.addEventListener('click', () => {
        const text = resCuYd?.textContent || '';
        if (text && text !== '—') {
          navigator.clipboard.writeText(text.replace(/,/g, '') + ' yd³');
          const prev = copyCuYdBtn.textContent;
          copyCuYdBtn.textContent = 'Copied!';
          setTimeout(() => { copyCuYdBtn.textContent = prev; }, 1800);
        }
      });

      calculate();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCuFtCalculator);
    } else {
      initCuFtCalculator();
    }
  </script>
</Layout>
