---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SHAPES } from '../../scripts/shapes';
import { HINDI_TOOLS } from '../../i18n/hindi-tools';
import { HUB_ALTERNATES, HUB_URLS } from '../../i18n/home-locales';

const HINDI_CATEGORIES = [
  { id: 'all', label: 'सभी आकृतियां' },
  { id: 'basic', label: 'मूल ज्यामिति' },
  { id: 'curved', label: 'गोल व शंकु' },
  { id: 'prisms_pyramids', label: 'प्रिज्म व पिरामिड' },
  { id: 'tanks_pipes', label: 'टैंक व पाइप' },
];

const hindiToolsList = Object.values(HINDI_TOOLS).map((tool) => {
  const shape = SHAPES[tool.shapeId];
  return {
    ...tool,
    shape,
  };
});

const canonical = HUB_URLS.hi;

const schemaGraph = [
  {
    '@type': 'CollectionPage',
    'name': 'सभी 16 3D आयतन कैलकुलेटरों की सूची',
    'description': 'हिंदी में 16 त्रिविमीय आकृतियों के आयतन कैलकुलेटरों की पूरी सूची, सूत्रों और रूपांतरण सहित।',
    'url': canonical,
  },
  {
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'होम',
        'item': 'https://thevolumecalculator.com/hi/',
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': 'कैलकुलेटर सूची',
        'item': canonical,
      },
    ],
  },
  {
    '@type': 'ItemList',
    'name': 'हिंदी 3D आयतन कैलकुलेटर',
    'numberOfItems': hindiToolsList.length,
    'itemListElement': hindiToolsList.map((tool, idx) => ({
      '@type': 'ListItem',
      'position': idx + 1,
      'name': tool.h1,
      'url': `https://thevolumecalculator.com/hi/${tool.slug}`,
    })),
  },
];
---

<Layout
  title="3D आयतन कैलकुलेटर सूची | thevolumecalculator.com"
  description="हिंदी में सभी 16 त्रिविमीय (3D) आकृतियों के आयतन कैलकुलेटर। सटीक सूत्र, चरण-दर-चरण गणना और लीटर एवं घन मीटर में रूपांतरण।"
  canonical={canonical}
  lang="hi"
  dir="ltr"
  ogLocale="hi_IN"
  alternates={HUB_ALTERNATES}
  schemaGraph={schemaGraph}
>
  <Header />

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10 sm:space-y-14">
    <!-- Hub Page Hero -->
    <section class="text-center max-w-3xl mx-auto pt-2 pb-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-white border border-hairline text-primary shadow-xs mb-3.5">
        <span class="w-2 h-2 rounded-full bg-primary"></span>
        <span>16 कैलकुलेटरों की सूची • 100% मुफ्त</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-ink tracking-tight leading-tight mb-3">
        सभी 3D आयतन कैलकुलेटर
      </h1>

      <p class="text-sm sm:text-base text-ink-secondary leading-relaxed max-w-2xl mx-auto">
        सभी 16 त्रिविमीय ज्यामितीय आकृतियों के लिए समर्पित आयतन कैलकुलेटर संग्रह। प्रत्येक कैलकुलेटर सटीक गणितीय सूत्र, चरण-दर-चरण गणना और लीटर एवं घन मीटर में त्वरित रूपांतरण प्रस्तुत करता है।
      </p>

      <!-- Instant Filter & Search Bar -->
      <div class="mt-6 max-w-md mx-auto relative">
        <input
          type="text"
          id="hub-search-input"
          aria-label="आयतन कैलकुलेटर खोजें"
          placeholder="आकृति खोजें (जैसे: बेलन, टैंक, शंकु, घनाभ)..."
          class="w-full px-4 py-2.5 pl-10 text-sm rounded-xl bg-white border border-hairline text-ink placeholder:text-ink-faint focus:outline-none focus:ring-2 focus:ring-primary shadow-xs"
        />
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 absolute left-3.5 top-3.5 text-ink-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
    </section>

    <!-- Category Filter Tabs -->
    <div class="flex items-center justify-start sm:justify-center gap-2 overflow-x-auto pb-2 px-1 sm:px-0 w-full scrollbar-none" aria-label="श्रेणी के अनुसार फ़िल्टर करें">
      {HINDI_CATEGORIES.map((cat, idx) => (
        <button
          type="button"
          aria-pressed={idx === 0 ? 'true' : 'false'}
          class={`hub-category-tab shrink-0 min-h-11 px-3.5 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all cursor-pointer ${
            idx === 0
              ? 'bg-primary text-white shadow-xs'
              : 'bg-white dark:bg-canvas-card text-ink-secondary border border-hairline hover:border-ink-muted'
          }`}
          data-category={cat.id}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- 16 Dedicated Calculators Grid -->
    <section class="space-y-4">
      <div id="hub-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {hindiToolsList.map((t) => (
          <div
            class="hub-tool-card bg-white rounded-2xl border border-hairline p-5 shadow-xs hover:border-primary/60 hover:shadow-sm transition-all flex flex-col justify-between group"
            data-category={t.shape.category}
            data-name={`${t.shapeName} ${t.h1} ${t.shortTagline} ${t.keywords}`.toLowerCase()}
          >
            <div>
              <!-- Header with Icon & Category Badge -->
              <div class="flex items-start justify-between gap-2 mb-3">
                <div class="w-10 h-10 rounded-xl bg-canvas-soft border border-hairline flex items-center justify-center text-primary group-hover:scale-105 transition-transform shrink-0">
                  <Fragment set:html={t.shape.iconSvg} />
                </div>
                <span class={`text-xs font-bold px-2.5 py-0.5 rounded-full border whitespace-nowrap shrink-0 ${t.shape.badgeColor}`}>
                  {t.categoryLabel}
                </span>
              </div>

              <!-- Title & Formula -->
              <h2 class="font-bold text-base text-ink group-hover:text-primary transition-colors leading-snug mb-1">
                {t.h1}
              </h2>

              <div class="inline-block mb-2.5">
                <span class="font-mono text-xs px-2 py-0.5 rounded bg-canvas-soft border border-hairline text-ink-secondary font-semibold">
                  {t.formulaHtml}
                </span>
              </div>

              <p class="text-xs text-ink-muted leading-relaxed line-clamp-3 mb-4">
                {t.shortTagline}
              </p>
            </div>

            <!-- Direct Link Button -->
            <a
              href={`/hi/${t.slug}`}
              class="w-full inline-flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl bg-canvas-soft border border-hairline text-xs font-bold text-ink group-hover:bg-primary group-hover:text-white group-hover:border-primary transition-all shadow-2xs"
            >
              <span>कैलकुलेटर खोलें</span>
              <span class="text-xs">→</span>
            </a>
          </div>
        ))}
      </div>

      <!-- No Results State -->
      <div id="hub-no-results" class="hidden text-center py-16 px-4">
        <p class="text-base font-bold text-ink">कोई कैलकुलेटर नहीं मिला</p>
        <p class="text-xs text-ink-muted mt-1">कृपया दूसरा शब्द खोजें या सभी श्रेणियां चुनें।</p>
        <button
          type="button"
          id="hub-reset-btn"
          class="mt-4 px-4 py-2 rounded-xl bg-primary text-white text-xs font-bold hover:bg-primary-hover transition-colors cursor-pointer"
        >
          फ़िल्टर रीसेट करें
        </button>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  function setupHubInteractions() {
    const searchInput = document.getElementById('hub-search-input') as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.hub-tool-card'));
    const categoryTabs = Array.from(document.querySelectorAll<HTMLElement>('.hub-category-tab'));
    const noResults = document.getElementById('hub-no-results');
    const resetBtn = document.getElementById('hub-reset-btn');

    let activeCategory = 'all';
    let searchQuery = '';

    function syncUrl() {
      const params = new URLSearchParams(window.location.search);
      if (searchQuery) params.set('q', searchQuery);
      else params.delete('q');
      if (activeCategory !== 'all') params.set('category', activeCategory);
      else params.delete('category');
      const query = params.toString();
      history.replaceState(null, '', `${window.location.pathname}${query ? `?${query}` : ''}`);
    }

    function filterTools() {
      let visibleCount = 0;
      cards.forEach((card) => {
        const category = card.getAttribute('data-category');
        const name = card.getAttribute('data-name') || '';

        const matchesCat = activeCategory === 'all' || category === activeCategory;
        const matchesQuery = !searchQuery || name.includes(searchQuery);

        if (matchesCat && matchesQuery) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (noResults) {
        if (visibleCount === 0) noResults.classList.remove('hidden');
        else noResults.classList.add('hidden');
      }

      syncUrl();
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
        filterTools();
      });
    }

    categoryTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        categoryTabs.forEach((t) => {
          t.setAttribute('aria-pressed', 'false');
          t.classList.remove('bg-primary', 'text-white', 'shadow-xs');
          t.classList.add('bg-white', 'text-ink-secondary', 'border', 'border-hairline');
        });

        tab.setAttribute('aria-pressed', 'true');
        tab.classList.remove('bg-white', 'text-ink-secondary', 'border', 'border-hairline');
        tab.classList.add('bg-primary', 'text-white', 'shadow-xs');

        activeCategory = tab.getAttribute('data-category') || 'all';
        filterTools();
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        activeCategory = 'all';

        categoryTabs.forEach((t, idx) => {
          if (idx === 0) {
            t.setAttribute('aria-pressed', 'true');
            t.classList.add('bg-primary', 'text-white', 'shadow-xs');
            t.classList.remove('bg-white', 'text-ink-secondary');
          } else {
            t.setAttribute('aria-pressed', 'false');
            t.classList.remove('bg-primary', 'text-white', 'shadow-xs');
            t.classList.add('bg-white', 'text-ink-secondary');
          }
        });

        filterTools();
      });
    }

    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get('q');
    const initialCategory = params.get('category');

    if (initialQuery && searchInput) {
      searchInput.value = initialQuery;
      searchQuery = initialQuery.toLowerCase();
    }

    if (initialCategory) {
      const targetTab = categoryTabs.find((t) => t.getAttribute('data-category') === initialCategory);
      if (targetTab) {
        categoryTabs.forEach((t) => {
          t.setAttribute('aria-pressed', 'false');
          t.classList.remove('bg-primary', 'text-white', 'shadow-xs');
          t.classList.add('bg-white', 'text-ink-secondary', 'border', 'border-hairline');
        });
        targetTab.setAttribute('aria-pressed', 'true');
        targetTab.classList.remove('bg-white', 'text-ink-secondary', 'border', 'border-hairline');
        targetTab.classList.add('bg-primary', 'text-white', 'shadow-xs');
        activeCategory = initialCategory;
      }
    }

    if (initialQuery || initialCategory) {
      filterTools();
    }
  }

  document.addEventListener('DOMContentLoaded', setupHubInteractions);
</script>
