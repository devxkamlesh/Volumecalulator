---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SimpleCalculator from '../components/SimpleCalculator.astro';
import FeaturedToolsSection from '../components/FeaturedToolsSection.astro';
import HomeSeoArticle, { HOME_FAQS } from '../components/HomeSeoArticle.astro';
import Footer from '../components/Footer.astro';
import { HOME_ALTERNATES, LOCALE_CODES, LOCALIZED_HOMES } from '../i18n/home-locales';

const title = 'Volume Calculator - Gallons, Litres & Cu Ft';
const description = 'Free online volume calculator to calculate volume for 16 3D shapes. Convert cubic volume in gallons, litres, cu ft, and m³ with instant step-by-step formulas.';
const keywords = 'volume calculator, calculate volume, volume calculator gallons, cu ft calculator, water volume calculator, volumetric calculator, volume solver, volume cal, cubic volume, volume formula, volumetric formula';
const canonical = 'https://thevolumecalculator.com/';
const ogImage = '/og-image.png';
const ogImageAlt = 'Volume Calculator - Calculate cubic volume and liquid capacity in gallons, litres, and cu ft';

const schemaGraph = [
  {
    '@type': 'Person',
    '@id': 'https://thevolumecalculator.com/#author',
    'name': 'Kamlesh Choudhary',
    'alternateName': 'devxkamlesh',
    'url': 'https://x.com/devxkamlesh',
    'image': 'https://thevolumecalculator.com/author.jpg',
    'jobTitle': 'Full Stack Engineer & AI Systems Architect',
    'alumniOf': {
      '@type': 'EducationalOrganization',
      'name': 'Mahatma Jyoti Rao Phoole University (MJRPU)',
    },
    'address': {
      '@type': 'PostalAddress',
      'addressLocality': 'Jaipur',
      'addressCountry': 'IN',
    },
    'sameAs': [
      'https://in.linkedin.com/in/devxkamlesh',
      'https://x.com/devxkamlesh',
      'https://github.com/devxkamlesh',
      'https://modrinth.com/user/devxkamlesh',
    ],
  },
  {
    '@type': 'SoftwareApplication',
    'name': 'Volume Calculator',
    'applicationCategory': 'EducationalApplication',
    'operatingSystem': 'Any',
    'author': {
      '@id': 'https://thevolumecalculator.com/#author',
    },
    'creator': {
      '@id': 'https://thevolumecalculator.com/#author',
    },
    'offers': {
      '@type': 'Offer',
      'price': '0',
      'priceCurrency': 'USD',
    },
    'description': description,
    'url': canonical,
  },
  {
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'Home',
        'item': canonical,
      },
    ],
  },
  {
    '@type': 'FAQPage',
    'mainEntity': HOME_FAQS.map((faq) => ({
      '@type': 'Question',
      'name': faq.question,
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': faq.answer,
      },
    })),
  },
];
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  ogType="website"
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  schemaGraph={schemaGraph}
  lang="en"
  dir="ltr"
  ogLocale="en_US"
  ogLocaleAlternates={LOCALE_CODES.map((code) => LOCALIZED_HOMES[code].ogLocale)}
  alternates={HOME_ALTERNATES}
>
  <Header />

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10 sm:space-y-14">
    <!-- Clean, Friendly Everyday Hero -->
    <section class="text-center max-w-2xl mx-auto pt-2 pb-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-white dark:bg-canvas-card border border-hairline text-primary shadow-xs mb-3.5">
        <span class="w-2 h-2 rounded-full bg-accent-green"></span>
        <span>Quick & Easy Volume Calculator</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-ink tracking-tight leading-tight mb-3">
        Online Volume Calculator
      </h1>

      <p class="text-sm sm:text-base text-ink-secondary leading-relaxed">
        Quickly calculate volume for boxes, cylinders, spheres, cubes, and cones. Enter your measurements into our volumetric calculator and volume solver for instant cubic volume and liquid capacity results in gallons, litres, cubic feet, and cubic meters.
      </p>
    </section>

    <!-- Simple, Easy-to-Use Calculator Card for Everyday Users -->
    <SimpleCalculator />

    <!-- Featured Calculators & Formulas Section for High-Intent SEO Links -->
    <FeaturedToolsSection />

    <!-- In-Depth SEO Guide & 12 IMP FAQs (1000 - 1500 Words) -->
    <HomeSeoArticle />

    <nav aria-label="Language" class="max-w-4xl mx-auto bg-white rounded-2xl border border-hairline p-5 sm:p-6 shadow-xs">
      <h2 class="text-base font-bold text-ink mb-1">Volume calculator languages</h2>
      <p class="text-xs text-ink-muted mb-4">Choose a fully localized calculator with metric defaults and native mathematical terminology.</p>
      <div class="flex flex-wrap gap-2">
        <a href="/" lang="en" hreflang="en" aria-current="page" class="min-h-11 inline-flex items-center px-3 rounded-lg border border-primary bg-primary/10 text-primary text-xs font-bold">English</a>
        {LOCALE_CODES.map((code) => (
          <a href={`/${code}/`} lang={LOCALIZED_HOMES[code].lang} hreflang={LOCALIZED_HOMES[code].lang} class="min-h-11 inline-flex items-center px-3 rounded-lg border border-hairline text-ink text-xs font-semibold hover:border-primary hover:text-primary transition-colors">
            {LOCALIZED_HOMES[code].languageName}
          </a>
        ))}
      </div>
    </nav>
  </main>

  <Footer />

  <!-- Simple calculator client script -->
  <script src="../scripts/simple-calculator.ts"></script>
</Layout>
