---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SHAPES } from '../../scripts/shapes';
import { RUSSIAN_TOOLS } from '../../i18n/russian-tools';
import { HUB_ALTERNATES, HUB_URLS } from '../../i18n/home-locales';

const RUSSIAN_CATEGORIES = [
  { id: 'all', label: 'Все формы' },
  { id: 'basic', label: 'Базовая геометрия' },
  { id: 'curved', label: 'Круглые тела и конусы' },
  { id: 'prisms_pyramids', label: 'Призмы и пирамиды' },
  { id: 'tanks_pipes', label: 'Резервуары и трубы' },
];

const russianToolsList = Object.values(RUSSIAN_TOOLS).map((tool) => {
  const shape = SHAPES[tool.shapeId];
  return {
    ...tool,
    shape,
  };
});

const canonical = HUB_URLS.ru;

const ogLocaleAlternates = ['ru_KZ', 'ru_BY', 'ru_UZ', 'ru_KG'];

const schemaGraph = [
  {
    '@type': 'CollectionPage',
    'name': 'Каталог из 16 калькуляторов объема 3D',
    'description': 'Полный каталог 16 калькуляторов геометрического объема 3D тел с точными формулами, пошаговыми вычислениями и переводом единиц.',
    'url': canonical,
  },
  {
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'Главная',
        'item': 'https://thevolumecalculator.com/ru/',
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': 'Калькуляторы',
        'item': canonical,
      },
    ],
  },
  {
    '@type': 'ItemList',
    'name': 'Калькуляторы объема геометрических тел на русском языке',
    'numberOfItems': russianToolsList.length,
    'itemListElement': russianToolsList.map((tool, idx) => ({
      '@type': 'ListItem',
      'position': idx + 1,
      'name': tool.h1,
      'url': `https://thevolumecalculator.com/ru/${tool.slug}`,
    })),
  },
];
---

<Layout
  title="Калькуляторы объема 3D | thevolumecalculator.com"
  description="Полный каталог 16 калькуляторов объема 3D тел на русском языке. Точные геометрические формулы, пошаговый расчет и мгновенный перевод в литры и м³."
  canonical={canonical}
  lang="ru"
  dir="ltr"
  ogLocale="ru_RU"
  ogLocaleAlternates={ogLocaleAlternates}
  alternates={HUB_ALTERNATES}
  schemaGraph={schemaGraph}
>
  <Header />

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10 sm:space-y-14">
    <!-- Hub page hero -->
    <section class="text-center max-w-3xl mx-auto pt-2 pb-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-white border border-hairline text-primary shadow-xs mb-3.5">
        <span class="w-2 h-2 rounded-full bg-primary"></span>
        <span>Каталог из 16 бесплатных инструментов</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-ink tracking-tight leading-tight mb-3">
        Все калькуляторы объема 3D
      </h1>

      <p class="text-sm sm:text-base text-ink-secondary leading-relaxed max-w-2xl mx-auto">
        Выберите геометрическую фигуру из каталога 16 онлайн калькуляторов. Каждый инструмент содержит точную формулу, математическую подстановку и перевод в литры и кубические метры.
      </p>

      <!-- Instant filter and search bar -->
      <div class="mt-6 max-w-md mx-auto relative">
        <input
          type="text"
          id="hub-search-input"
          aria-label="Поиск калькулятора объема"
          placeholder="Поиск по фигуре (например: цилиндр, бак, конус)..."
          class="w-full px-4 py-2.5 pl-10 text-sm rounded-xl bg-white border border-hairline text-ink placeholder:text-ink-faint focus:outline-none focus:ring-2 focus:ring-primary shadow-xs"
        />
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 absolute left-3.5 top-3.5 text-ink-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
    </section>

    <!-- Category filter tabs -->
    <div class="flex items-center justify-start sm:justify-center gap-2 overflow-x-auto pb-2 px-1 sm:px-0 w-full scrollbar-none" aria-label="Фильтр калькуляторов по категориям">
      {RUSSIAN_CATEGORIES.map((cat, idx) => (
        <button
          type="button"
          aria-pressed={idx === 0 ? 'true' : 'false'}
          class={`hub-category-tab shrink-0 min-h-11 px-3.5 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all cursor-pointer ${
            idx === 0
              ? 'bg-primary text-white shadow-xs'
              : 'bg-white dark:bg-canvas-card text-ink-secondary border border-hairline hover:border-ink-muted'
          }`}
          data-category={cat.id}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- 16 dedicated calculators grid -->
    <section class="space-y-4">
      <div id="hub-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {russianToolsList.map((t) => (
          <div
            class="hub-tool-card bg-white rounded-2xl border border-hairline p-5 shadow-xs hover:border-primary/60 hover:shadow-sm transition-all flex flex-col justify-between group"
            data-category={t.shape.category}
            data-name={`${t.shapeName} ${t.h1} ${t.shortTagline} ${t.keywords}`.toLowerCase()}
          >
            <div>
              <!-- Header with icon and category badge -->
              <div class="flex items-start justify-between gap-2 mb-3">
                <div class="w-10 h-10 rounded-xl bg-canvas-soft border border-hairline flex items-center justify-center text-primary group-hover:scale-105 transition-transform shrink-0">
                  <Fragment set:html={t.shape.iconSvg} />
                </div>
                <span class={`text-xs font-bold px-2.5 py-0.5 rounded-full border whitespace-nowrap shrink-0 ${t.shape.badgeColor}`}>
                  {t.categoryLabel}
                </span>
              </div>

              <!-- Title and formula -->
              <h2 class="font-bold text-base text-ink group-hover:text-primary transition-colors leading-snug mb-1">
                {t.h1}
              </h2>

              <div class="inline-block mb-2.5">
                <span class="font-mono text-xs px-2 py-0.5 rounded bg-canvas-soft border border-hairline text-ink-secondary font-semibold">
                  {t.formulaHtml}
                </span>
              </div>

              <p class="text-xs text-ink-muted leading-relaxed line-clamp-3 mb-4">
                {t.shortTagline}
              </p>
            </div>

            <!-- Direct link button -->
            <a
              href={`/ru/${t.slug}`}
              class="w-full inline-flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl bg-canvas-soft border border-hairline text-xs font-bold text-ink group-hover:bg-primary group-hover:text-white group-hover:border-primary transition-all shadow-2xs"
            >
              <span>Открыть калькулятор</span>
              <span class="text-xs">→</span>
            </a>
          </div>
        ))}
      </div>

      <!-- No results state -->
      <div id="hub-no-results" class="hidden text-center py-16 px-4">
        <p class="text-base font-bold text-ink">Калькуляторы не найдены</p>
        <p class="text-xs text-ink-muted mt-1">Измените поисковый запрос или выберите вкладку со всеми категориями.</p>
        <button
          type="button"
          id="hub-reset-btn"
          class="mt-4 px-4 py-2 rounded-xl bg-primary text-white text-xs font-bold hover:bg-primary-hover transition-colors cursor-pointer"
        >
          Сбросить фильтры
        </button>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  function setupHubInteractions() {
    const searchInput = document.getElementById('hub-search-input') as HTMLInputElement | null;
    const categoryTabs = document.querySelectorAll<HTMLButtonElement>('.hub-category-tab');
    const cards = document.querySelectorAll<HTMLElement>('.hub-tool-card');
    const noResults = document.getElementById('hub-no-results');
    const resetBtn = document.getElementById('hub-reset-btn');

    let activeCategory = 'all';
    let searchQuery = '';

    function filterTools() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const cardCategory = card.getAttribute('data-category') || '';
        const cardName = card.getAttribute('data-name') || '';

        const matchesCategory = activeCategory === 'all' || cardCategory === activeCategory;
        const matchesSearch = !searchQuery || cardName.includes(searchQuery);

        if (matchesCategory && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    categoryTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        categoryTabs.forEach((t) => {
          t.classList.remove('bg-primary', 'text-white', 'shadow-xs');
          t.classList.add('bg-white', 'dark:bg-canvas-card', 'text-ink-secondary', 'border', 'border-hairline');
          t.setAttribute('aria-pressed', 'false');
        });

        tab.classList.remove('bg-white', 'dark:bg-canvas-card', 'text-ink-secondary', 'border', 'border-hairline');
        tab.classList.add('bg-primary', 'text-white', 'shadow-xs');
        tab.setAttribute('aria-pressed', 'true');

        activeCategory = tab.getAttribute('data-category') || 'all';
        filterTools();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
        filterTools();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        activeCategory = 'all';

        categoryTabs.forEach((t, idx) => {
          if (idx === 0) {
            t.classList.remove('bg-white', 'dark:bg-canvas-card', 'text-ink-secondary', 'border', 'border-hairline');
            t.classList.add('bg-primary', 'text-white', 'shadow-xs');
            t.setAttribute('aria-pressed', 'true');
          } else {
            t.classList.remove('bg-primary', 'text-white', 'shadow-xs');
            t.classList.add('bg-white', 'dark:bg-canvas-card', 'text-ink-secondary', 'border', 'border-hairline');
            t.setAttribute('aria-pressed', 'false');
          }
        });

        filterTools();
      });
    }
  }

  document.addEventListener('DOMContentLoaded', setupHubInteractions);
</script>
